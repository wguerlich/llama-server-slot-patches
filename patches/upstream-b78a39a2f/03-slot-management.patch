new file mode 100644
index 0000000..7c625d2
--- /dev/null
+++ b/tools/server/tests-snap/run.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+# run.sh — the test bed. Starts a server per case and checks what it does.
+#
+#   MODEL=/path/to/model.gguf ./run.sh                  # the model's own template
+#   MODEL=... ./run.sh templates/last.jinja  tmpl-last  # one of the bundled templates
+#
+# Environment:
+#   MODEL          required, path to a GGUF
+#   LLAMA_SERVER   default: ../../../build/bin/llama-server
+#   PORT           default: 8099
+#   CTX            default: 8192
+#   CASES          default: every harness type
+#   PRE            optional, sourced before the server starts (env for your backend)
+#
+# A fresh server per case is deliberate: the probe's learned state is per slot and
+# would otherwise carry from one case into the next.
+# Two slots, not one: with a single slot a rejected continuation lands in the same slot
+# anyway and looks like a hit. Only a second, empty slot makes "nothing reachable" visible.
+set -uo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TMPL="${1:-native}"
+NAME="${2:-native}"
+
+: "${MODEL:?set MODEL to a .gguf}"
+LLAMA_SERVER="${LLAMA_SERVER:-$HERE/../../../build/bin/llama-server}"
+PORT="${PORT:-8099}"
+CTX="${CTX:-8192}"
+CASES="${CASES:-preserve strip last-only wrapped tools tools-think seam rewrite mixed wrapped-hint toolloop mid-system}"
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"; [ -n "${SRV:-}" ] && kill "$SRV" 2>/dev/null' EXIT
+
+start_server() {
+    local log=$1
+    [ -n "${SRV:-}" ] && { kill "$SRV" 2>/dev/null; wait "$SRV" 2>/dev/null; sleep 3; }
+    local extra=()
+    [ "$TMPL" != "native" ] && extra+=(--chat-template-file "$TMPL")
+    ( [ -n "${PRE:-}" ] && source "$PRE"
+      exec "$LLAMA_SERVER" -m "$MODEL" \
+        --host 127.0.0.1 --port "$PORT" -c "$CTX" \
+        -ngl 99 --flash-attn on -fit off --kv-unified \
+        --jinja --parallel 2 --no-ui \
+        --ctx-checkpoints 8 --checkpoint-min-step 0 \
+        --slot-save-path "$WORK/slots" \
+        --telemetry-file "$log" "${extra[@]}" ) > "$WORK/server.log" 2>&1 &
+    SRV=$!
+    for _ in $(seq 1 120); do
+        sleep 2
+        grep -q 'listening on' "$WORK/server.log" && return 0
+        kill -0 "$SRV" 2>/dev/null || break
+    done
+    echo "  server did not come up:"; tail -8 "$WORK/server.log" | sed 's/^/    /'
+    return 1
+}
+
+mkdir -p "$WORK/slots"
+echo "########## template: $NAME ##########"
+total=0
+for c in $CASES; do
+    log="$WORK/tel-$c.jsonl"
+    : > "$log"
+    if ! start_server "$log"; then
+        echo "  $c: SKIPPED"
+        continue
+    fi
+    out=$(BASE="http://127.0.0.1:$PORT" python3 "$HERE/suite.py" "$log" "$c" 2>&1)
+    echo "$out" | grep -v '^  total'
+    n=$(echo "$out" | sed -n 's/^  total: \([0-9]*\).*/\1/p')
+    total=$((total + ${n:-0}))
+done
+echo "  ===> $NAME: $total finding(s)"
+[ "$total" -eq 0 ]
