index 0000000..89e77d2
--- /dev/null
+++ b/tools/server/tests-snap/suite.py
@@ -0,0 +1,467 @@
+#!/usr/bin/env python3
+"""
+Test bed for the divergence probe and the in-band hint channel.
+
+The LLM is simulated: assistant replies are made up by the driver rather than
+generated. Every run is therefore deterministic and the history exactly
+controlled - what is under test is the template and the tokenizer, not the model.
+
+Checked on two levels:
+
+  text   what the template renders, whether markers vanish without a trace, and
+         whether a harness WITH the channel renders byte-identically to one
+         without it.
+  token  where two consecutive prompts actually part. That truth is computed
+         independently of the server (/apply-template + /tokenize) and held
+         against what the probe predicted.
+"""
+import json, os, sys, time, urllib.request
+
+BASE = os.environ.get("BASE", "http://127.0.0.1:8099")
+
+def post(path, body, timeout=600):
+    r = urllib.request.Request(BASE + path, data=json.dumps(body).encode(),
+                               headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(r, timeout=timeout) as f:
+        return json.load(f)
+
+def render(msgs, tools=None):
+    b = {"messages": msgs}
+    if tools:
+        b["tools"] = tools
+    return post("/apply-template", b)["prompt"]
+
+def tokens(text):
+    return post("/tokenize", {"content": text})["tokens"]
+
+def slot_len():
+    import urllib.request
+    with urllib.request.urlopen(BASE + "/slots", timeout=30) as f:
+        d = json.load(f)
+    return d[0].get("n_prompt_tokens_cache", -1)
+
+def erase_slot():
+    """Clear the slot so a case inherits neither content nor learned state from the
+    previous one. Verified: a silent failure would make the whole run worthless."""
+    for attempt in range(5):
+        post("/slots/0?action=erase", {}, timeout=60)
+        time.sleep(0.15)
+        if slot_len() <= 0:
+            return
+    raise RuntimeError(f"slot will not clear (still holds {slot_len()})")
+
+def infer(msgs, tools=None, mt=1):
+    b = {"messages": msgs, "max_tokens": mt, "temperature": 0}
+    if tools:
+        b["tools"] = tools
+    return post("/v1/chat/completions", b)
+
+def token_prefix(a, b):
+    n = min(len(a), len(b)); i = 0
+    while i < n and a[i] == b[i]:
+        i += 1
+    return i
+
+# ---------------------------------------------------------------------------
+# Fixed conversation material, so every run is identical
+# ---------------------------------------------------------------------------
+FILLER = ("context data system memory bandwidth kernel tensor matrix gradient "
+          "throughput pipeline register allocation quantisation embedding attention ") * 6
+
+TURNS = [
+    ("First question, about memory. " + FILLER,
+     "Answer one: memory is the bottleneck.",
+     "Let me check bandwidth and latency."),
+    ("Second question, about cores. " + FILLER,
+     "Answer two: the cores wait on data.",
+     "Arithmetic intensity is what counts here, so I work it out."),
+    ("Third question, about cache. " + FILLER,
+     "Answer three: the cache decides.",
+     "I compare the hit rates of the levels."),
+    ("Fourth question, about time. " + FILLER,
+     "Answer four: time per task is what counts.",
+     "Latency and throughput are different regimes; I keep them apart."),
+]
+
+TOOLS = [{"type": "function", "function": {
+    "name": "lookup", "description": "Look something up",
+    "parameters": {"type": "object", "properties": {"q": {"type": "string"}}, "required": ["q"]}}}]
+
+SYS = "You are a terse assistant."
+
+# ---------------------------------------------------------------------------
+# Harness types: how a client sends the history back
+# ---------------------------------------------------------------------------
+
+def h_preserve(k):
+    """every assistant turn carries its reasoning back"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, r = TURNS[i]
+        m.append({"role": "user", "content": u})
+        m.append({"role": "assistant", "content": a, "reasoning_content": r})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+def h_strip(k):
+    """reasoning is never sent back"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, _ = TURNS[i]
+        m.append({"role": "user", "content": u})
+        m.append({"role": "assistant", "content": a})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+def h_last_only(k):
+    """only the most recent assistant turn carries reasoning"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, r = TURNS[i]
+        m.append({"role": "user", "content": u})
+        if i == k - 1:
+            m.append({"role": "assistant", "content": a, "reasoning_content": r})
+        else:
+            m.append({"role": "assistant", "content": a})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+def h_wrapped(k):
+    """the whole history sits in ONE user message"""
+    parts = []
+    for i in range(k):
+        u, a, r = TURNS[i]
+        parts.append(f"<turn><user>{u}</user><think>{r}</think><assistant>{a}</assistant></turn>")
+    parts.append(f"<turn><user>{TURNS[k][0]}</user>")
+    return [{"role": "system", "content": SYS},
+            {"role": "user", "content": "\n".join(parts)}], None
+
+def h_tools(k):
+    """tool loop without reasoning"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, _ = TURNS[i]
+        m.append({"role": "user", "content": u})
+        m.append({"role": "assistant", "content": "",
+                  "tool_calls": [{"id": f"c{i}", "type": "function",
+                                  "function": {"name": "lookup", "arguments": '{"q":"x"}'}}]})
+        m.append({"role": "tool", "tool_call_id": f"c{i}", "content": "Result " + str(i)})
+        m.append({"role": "assistant", "content": a})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, TOOLS
+
+def h_tools_think(k):
+    """tool loop WITH preserved reasoning"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, r = TURNS[i]
+        m.append({"role": "user", "content": u})
+        m.append({"role": "assistant", "content": "", "reasoning_content": r,
+                  "tool_calls": [{"id": f"c{i}", "type": "function",
+                                  "function": {"name": "lookup", "arguments": '{"q":"x"}'}}]})
+        m.append({"role": "tool", "tool_call_id": f"c{i}", "content": "Result " + str(i)})
+        m.append({"role": "assistant", "content": a, "reasoning_content": r})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, TOOLS
+
+def h_seam(k):
+    """messages end in whitespace - the prompt end gets re-tokenized as it grows"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, r = TURNS[i]
+        m.append({"role": "user", "content": u + "\n"})
+        m.append({"role": "assistant", "content": a + "\n", "reasoning_content": r})
+    m.append({"role": "user", "content": TURNS[k][0] + "\n"})
+    return m, None
+
+def h_rewrite(k):
+    """the harness summarises its own history from turn 2 on"""
+    m = [{"role": "system", "content": SYS}]
+    if k >= 2:
+        m.append({"role": "user", "content": "Discussed so far: " + "; ".join(t[1] for t in TURNS[:k])})
+        m.append({"role": "assistant", "content": "Understood."})
+    else:
+        for i in range(k):
+            u, a, r = TURNS[i]
+            m.append({"role": "user", "content": u})
+            m.append({"role": "assistant", "content": a, "reasoning_content": r})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+def h_mixed(k):
+    """switches from preserving to dropping at turn 2"""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, r = TURNS[i]
+        m.append({"role": "user", "content": u})
+        if k < 2:
+            m.append({"role": "assistant", "content": a, "reasoning_content": r})
+        else:
+            m.append({"role": "assistant", "content": a})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+SECRET = "T3ST-S3CR3T"
+ENABLE = f"<<llama-snap enable secret={SECRET}>>"
+
+def h_wrapped_hint(k):
+    """like h_wrapped, but the harness declares where it will resume. The marker sits
+    at the end of the user message - exactly where the next turn attaches, and
+    exactly what no template render can work out."""
+    parts = []
+    for i in range(k):
+        u, a, r = TURNS[i]
+        parts.append(f"<turn><user>{u}</user><think>{r}</think><assistant>{a}</assistant></turn>")
+    parts.append(f"<turn><user>{TURNS[k][0]}</user>")
+    body = "\n".join(parts) + f"\n<<llama-snap ckpt secret={SECRET}>>"
+    return [{"role": "system", "content": SYS + "\n" + ENABLE},
+            {"role": "user", "content": body}], None
+
+def h_wrapped_plain(k):
+    """the same harness WITHOUT the channel - for the byte comparison"""
+    parts = []
+    for i in range(k):
+        u, a, r = TURNS[i]
+        parts.append(f"<turn><user>{u}</user><think>{r}</think><assistant>{a}</assistant></turn>")
+    parts.append(f"<turn><user>{TURNS[k][0]}</user>")
+    return [{"role": "system", "content": SYS},
+            {"role": "user", "content": "\n".join(parts)}], None
+
+# A REAL tool loop: every iteration is its own request. The shapes above only carry a tool call in
+# their history; nothing there ever asks the server to continue after a tool result. That is the
+# case the probe's far-back candidates come from - under a template that keeps reasoning inside a
+# tool loop and strips it once a user turn follows (Qwen3-style last_query_index), the user turn
+# parts at the FIRST think block of the loop, a position the probe computes on every iteration and
+# that lies behind the prefill each time. The loop is longer than --ctx-checkpoints on purpose:
+# the position has to survive the cap.
+TOOL_LOOP_ITER = 9
+
+def h_toolloop(k):
+    """k = 0: the question. k = 1..TOOL_LOOP_ITER: one tool result each. k = TOOL_LOOP_ITER + 1:
+    the agent's answer followed by the next question."""
+    m = [{"role": "system", "content": SYS + " " + FILLER}]
+    m.append({"role": "user", "content": "Please investigate the first question. " + FILLER})
+    n_iter = min(k, TOOL_LOOP_ITER)
+    for i in range(n_iter):
+        m.append({"role": "assistant", "content": "", "reasoning_content": f"I should look up item {i}. " + FILLER[:200],
+                  "tool_calls": [{"id": f"c{i}", "type": "function",
+                                  "function": {"name": "lookup", "arguments": json.dumps({"q": f"item {i}"})}}]})
+        m.append({"role": "tool", "tool_call_id": f"c{i}", "content": f"Result {i}: " + FILLER[:300]})
+    if k > TOOL_LOOP_ITER:
+        m.append({"role": "assistant", "content": "Done: the answer is 42.", "reasoning_content": "Summing up. " + FILLER[:100]})
+        m.append({"role": "user", "content": "Thanks. Now the second question. " + FILLER})
+    return m, TOOLS
+
+def h_mid_system(k):
+    """a system message before every user turn - the way modern harnesses steer mid-conversation.
+    Needs a template that renders system messages inline; the model's own may refuse them."""
+    m = [{"role": "system", "content": SYS}]
+    for i in range(k):
+        u, a, _ = TURNS[i]
+        m.append({"role": "system", "content": f"Status update {i}: proceed."})
+        m.append({"role": "user", "content": u})
+        m.append({"role": "assistant", "content": a})
+    m.append({"role": "system", "content": f"Status update {k}: proceed."})
+    m.append({"role": "user", "content": TURNS[k][0]})
+    return m, None
+
+HARNESSES = {
+    "preserve":    h_preserve,
+    "strip":       h_strip,
+    "last-only":   h_last_only,
+    "wrapped":     h_wrapped,
+    "tools":       h_tools,
+    "tools-think": h_tools_think,
+    "seam":        h_seam,
+    "rewrite":     h_rewrite,
+    "mixed":       h_mixed,
+    "wrapped-hint": h_wrapped_hint,
+    "toolloop":    h_toolloop,
+    "mid-system":  h_mid_system,
+}
+
+# requests per case; the default is four turns
+N_TURNS = {"toolloop": TOOL_LOOP_ITER + 2}
+
+# Harnesses whose next prompt no template render can derive: they rewrite their own
+# history. What is asked of the probe here is not accuracy but giving up - and the
+# hint channel is the remedy.
+UNPREDICTABLE = {"wrapped", "rewrite"}
+
+# ---------------------------------------------------------------------------
+# Der Durchlauf
+# ---------------------------------------------------------------------------
+
+def read_telemetry(path, since):
+    rows = []
+    if not os.path.exists(path):
+        return rows
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                rows.append(json.loads(line))
+    return rows[since:]
+
+def check_byte_identity(a_builder, b_builder, n_turns=4):
+    """Text level: a harness WITH the channel must render byte-identically to one without."""
+    out = []
+    for k in range(n_turns):
+        ma, ta = a_builder(k)
+        mb, tb = b_builder(k)
+        ra, rb = render(ma, ta), render(mb, tb)
+        if ra != rb:
+            i = 0
+            while i < min(len(ra), len(rb)) and ra[i] == rb[i]:
+                i += 1
+            out.append(f"T{k}: render differs from char {i}: "
+                       f"{ra[max(0,i-40):i+40]!r} vs {rb[max(0,i-40):i+40]!r}")
+        elif tokens(ra) != tokens(rb):
+            out.append(f"T{k}: same text but different tokens")
+    return out
+
+
+def run_case(name, builder, telpath, n_turns=4):
+    """Returns a list of findings (empty = everything in order)."""
+    findings = []
+
+    # --- oracle: the real prompts and their tokens, without asking the server ---
+    prompts, toks = [], []
+    for k in range(n_turns):
+        msgs, tools = builder(k)
+        p = render(msgs, tools)
+        prompts.append(p)
+        toks.append(tokens(p))
+
+    # the actual divergence between turn k and k+1
+    truth = []
+    for k in range(n_turns - 1):
+        truth.append(token_prefix(toks[k], toks[k + 1]))
+
+    # --- server: actually send the same sequence ---
+    erase_slot()
+    before = len(read_telemetry(telpath, 0))
+    for k in range(n_turns):
+        msgs, tools = builder(k)
+        infer(msgs, tools)
+    time.sleep(0.4)
+    rows = read_telemetry(telpath, before)
+
+    if len(rows) < n_turns:
+        findings.append(f"only {len(rows)} of {n_turns} telemetry rows")
+        return findings, truth, rows, toks
+
+    HINTED = {"wrapped-hint"}
+
+    needs_ckpt = False   # set as soon as the model is seen to create any
+    for k in range(n_turns - 1):
+        r    = rows[k]
+        nxt  = rows[k + 1]
+        n_now = len(toks[k])
+        d     = truth[k]
+        cons  = r.get("probe_all") or []    # what the probe considered
+        pred  = r.get("probe") or []        # what was placed as a checkpoint
+        ckpts = r.get("checkpoints") or []  # everything the slot held after turn k
+
+        # (A) reachability - holds for EVERY harness, by whatever mechanism: a follow-up
+        #     turn must be able to resume without recomputing anything.
+        lcp = nxt.get("lcp")
+        # A follow-up served from a FRESH slot has lcp 0 by construction: the picker found nothing
+        # reachable in the session's slot and moved on. With two slots that is what a divergence
+        # below every checkpoint looks like (rewrite: 14 tokens after the system prompt), and it is
+        # the right call, not a finding - the recomputation it costs is counted below.
+        fresh = nxt.get("hit") == "full" and lcp == 0
+        if lcp != d and not fresh:
+            findings.append(f"T{k+1}: lcp {lcp} != expected divergence {d}")
+        # restore_at is where computation actually resumed - whether a checkpoint, a snapshot
+        # or the live state carried it. Its distance from the divergence IS the recomputation,
+        # and that belongs at zero.
+        # A structural range candidate (rewrite of the last user turn, a dropped block behind its
+        # tag) resumes a few tokens early by construction; the end anchor's own slack is 4.
+        ra = nxt.get("restore_at", -1)
+        if ra is not None and ra >= 0 and lcp is not None and (ra > lcp or lcp - ra > 8) and name not in UNPREDICTABLE:
+            findings.append(f"T{k+1}: resumed at {ra} but diverged at {lcp} "
+                            f"-> {lcp - ra} tokens recomputed")
+
+        # Does this model create checkpoints at all? A model with partial seq_rm support does
+        # not need them and never will, however the placement logic behaves - so the checks that
+        # are about WHERE a checkpoint sits cannot say anything here.
+        if ckpts:
+            needs_ckpt = True
+
+        # (B) prediction - only required where the template can derive it
+        if name in UNPREDICTABLE:
+            pass   # (D) is checked after the loop, where the rule applies
+        elif name in HINTED:
+            # The hint must have hit the spot, not the probe - but only on a model that needs
+            # checkpoints at all. A plain attention model supports partial seq_rm, so the slot
+            # rolls back to any position without one and the list stays empty by design. Demanding
+            # a checkpoint there reports a failure where the mechanism worked perfectly, which is
+            # what this check did on every template until 2026-09-15.
+            if needs_ckpt is False:
+                pass
+            elif d not in ckpts:
+                findings.append(f"T{k}: divergence {d} is in no checkpoint {ckpts}")
+        elif d < n_now and d not in cons and not any(lo <= d <= hi for lo, hi in zip(cons, r.get("probe_hi") or cons)):
+            findings.append(f"T{k}: real divergence at {d} (of {n_now}) is not among the "
+                            f"considered candidates {cons} (ranges up to {r.get('probe_hi')})")
+
+        # (C) convergence: from the third follow-up turn on, place only one. A template that
+        #     re-renders the last user turn (kind 4) has a second, genuinely possible future next to
+        #     it - a tool result does not end the user turn - so two are allowed there.
+        kinds = r.get("probe_kinds") or []
+        if k >= 2 and name not in UNPREDICTABLE and name not in HINTED and len(pred) > 1 and 4 not in kinds:
+            findings.append(f"T{k}: still placing {len(pred)} checkpoints {pred} after {k} "
+                            f"follow-up turns, {d} is what is needed")
+
+    # (D) A harness the template cannot predict must silence the probe after two misses -
+    #     under the cap a wrongly placed checkpoint displaces a right one, and at full
+    #     context each one costs hundreds of MiB.
+    if name in UNPREDICTABLE:
+        # Two acceptable outcomes: the probe never placed anything (then there is nothing to
+        # place wrongly), or it stopped after two misses. What is NOT acceptable: still placing
+        # after two misses.
+        last = rows[-1]
+        ever = any(r.get("probe") for r in rows)
+        if ever and (last.get("probe_miss") or 0) >= 2 and last.get("probe"):
+            findings.append(f"T{n_turns-1}: still guessing ({last.get('probe')}) after "
+                            f"{last.get('probe_miss')} miss(es)")
+        # and the cost is reported, not held against it
+
+    # text level: the channel must not change the render
+    if name == "wrapped-hint":
+        findings += check_byte_identity(h_wrapped_hint, h_wrapped_plain, n_turns)
+
+    return findings, truth, rows, toks
+
+
+def main():
+    telpath = sys.argv[1]
+    only = sys.argv[2] if len(sys.argv) > 2 else None
+    total_f = 0
+    for name, builder in HARNESSES.items():
+        if only and only != name:
+            continue
+        try:
+            f, truth, rows, toks = run_case(name, builder, telpath, N_TURNS.get(name, 4))
+        except Exception as e:
+            print(f"  {name:<12} ERROR {e}")
+            total_f += 1
+            continue
+        preds = [(r.get("probe_all") or []) for r in rows]
+        # the figure that matters: how many tokens a follow-up turn had to recompute
+        # a fresh slot recomputed everything up to the divergence, a taken one lcp - restore_at
+        cost = sum((truth[i] if rows[i+1].get("hit") == "full" else
+                    max(0, (rows[i+1].get("lcp") or 0) - (rows[i+1].get("restore_at") or 0)))
+                   for i in range(len(rows) - 1))
+        status = "ok" if not f else f"{len(f)} FINDING(S)"
+        print(f"  {name:<13} divergence {str(truth):<18} probe {str(preds):<34} "
+              f"recomputed {cost:>5}  -> {status}")
+        for line in f:
+            print(f"      ! {line}")
+        total_f += len(f)
+    print(f"\n  total: {total_f} finding(s)")
+    return 1 if total_f else 0
+
+if __name__ == "__main__":
+    sys.exit(main())
