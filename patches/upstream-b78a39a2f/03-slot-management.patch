new file mode 100644
index 0000000..e35defe
--- /dev/null
+++ b/tools/server/tests-snap/index-test.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""
+The prefix index: what earns a file on disk.
+
+Three claims:
+
+  1. A SINGLE session cannot inflate the index and cannot fork against itself.
+     All of its turns truncate to the same preamble.
+
+  2. IDENTICAL preambles are uninteresting: they fork nowhere and trigger
+     nothing, however often they arrive.
+
+  3. ONE fork is enough: as soon as a second, different preamble agrees down to
+     some depth and then parts, that shared prefix is worth a file.
+
+The LLM is simulated: assistant replies are made up by the driver.
+
+  BASE=http://127.0.0.1:8099 python3 index-test.py <telemetry.jsonl> <snapshot-dir>
+"""
+import json, os, sys, time, urllib.request
+
+BASE = os.environ.get("BASE", "http://127.0.0.1:8099")
+
+def post(path, body, timeout=600):
+    r = urllib.request.Request(BASE + path, data=json.dumps(body).encode(),
+                               headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(r, timeout=timeout) as f:
+        return json.load(f)
+
+def infer(msgs, mt=1):
+    return post("/v1/chat/completions", {"messages": msgs, "max_tokens": mt, "temperature": 0})
+
+def erase():
+    post("/slots/0?action=erase", {}, timeout=60)
+
+def tel(path, since=0):
+    if not os.path.exists(path):
+        return []
+    return [json.loads(l) for l in open(path) if l.strip()][since:]
+
+def snaps(d):
+    return sorted(f for f in os.listdir(d) if f.endswith(".lsnp"))
+
+# large enough to clear --snapshot-min-tokens
+WORDS = ("architecture memory bandwidth latency kernel tensor matrix gradient throughput "
+         "pipeline register allocation quantisation embedding attention residual "
+         "normalisation checkpoint deployment container filesystem partition ")
+DOC = WORDS * 40
+SYS = "You are a terse assistant answering questions about systems."
+
+def preamble(doc=DOC):
+    return [{"role": "system", "content": SYS},
+            {"role": "user", "content": "Here is the document:\n" + doc + "\nKeep it in mind."}]
+
+def main():
+    telpath, snapdir = sys.argv[1], sys.argv[2]
+    findings = []
+
+    # ---------------------------------------------------------------
+    print("A) one session, six turns - must not fill the index")
+    erase()
+    n0 = len(tel(telpath))
+    msgs = preamble()
+    for t in range(6):
+        if t:
+            msgs = msgs + [{"role": "assistant", "content": f"Answer {t}."},
+                           {"role": "user", "content": f"Follow-up {t} about the document."}]
+        infer(msgs)
+    time.sleep(0.4)
+    rows = tel(telpath, n0)
+    sizes = [r.get("idx_size") for r in rows]
+    saved = [r.get("snap_saved") for r in rows]
+    print(f"   index size per turn : {sizes}")
+    print(f"   snapshots written   : {saved}")
+    if max(sizes) > 1:
+        findings.append(f"one session grew the index to {max(sizes)} entries, expected at most 1")
+    if any(saved):
+        findings.append(f"a single session triggered a snapshot: {saved}")
+
+    # ---------------------------------------------------------------
+    print("\nB) three sessions with an IDENTICAL preamble - must trigger nothing")
+    before = set(snaps(snapdir))
+    n0 = len(tel(telpath))
+    for q in ["What is the bottleneck?",
+              "What part does the cache play?",
+              "How does this scale with context length?"]:
+        erase()
+        infer(preamble() + [{"role": "assistant", "content": "Understood."},
+                            {"role": "user", "content": q}])
+    time.sleep(0.6)
+    rows = tel(telpath, n0)
+    new = sorted(set(snaps(snapdir)) - before)
+    print(f"   index size per request : {[r.get('idx_size') for r in rows]}")
+    print(f"   idx_lcp2 / idx_lcp3    : {[(r.get('idx_lcp2'), r.get('idx_lcp3')) for r in rows]}")
+    print(f"   snap_saved             : {[r.get('snap_saved') for r in rows]}")
+    print(f"   new files              : {new or 'NONE'}")
+    if new:
+        findings.append(f"identical preambles triggered a snapshot: {new}")
+
+    # ---------------------------------------------------------------
+    print("\nB2) preambles that part INSIDE the first message - ONE fork is enough")
+    before = set(snaps(snapdir))
+    n0 = len(tel(telpath))
+    for task in [
+            "Summarise the document in three sentences and name its key terms.",
+            "Translate the first two paragraphs and explain the technical terms briefly.",
+            "Find contradictions between the paragraphs and list each with a reason."]:
+        erase()
+        infer([{"role": "system", "content": SYS},
+               {"role": "user", "content": "Here is the document:\n" + DOC + "\n" + task}])
+    time.sleep(0.6)
+    rows = tel(telpath, n0)
+    new2 = sorted(set(snaps(snapdir)) - before)
+    print(f"   index size per request : {[r.get('idx_size') for r in rows]}")
+    print(f"   snap_saved             : {[r.get('snap_saved') for r in rows]}")
+    print(f"   new files              : {new2 or 'NONE'}")
+    for f in new2:
+        print(f"      {f}  {os.stat(os.path.join(snapdir, f)).st_size/1e6:.1f} MB")
+    if not new2:
+        findings.append("preambles that part produced no fork")
+
+    # ---------------------------------------------------------------
+    print("\nC) another session with the same document - must LOAD the snapshot")
+    n0 = len(tel(telpath))
+    erase()
+    infer([{"role": "system", "content": SYS},
+           {"role": "user", "content": "Here is the document:\n" + DOC +
+            "\nCheck the terms for consistency and report any deviation with a reason."}])
+    time.sleep(0.4)
+    r = tel(telpath, n0)[0]
+    print(f"   hit={r.get('hit')} snap_loaded={r.get('snap_loaded')} "
+          f"ms_snap_load={r.get('ms_snap_load')} restore_at={r.get('restore_at')}")
+    if not r.get("snap_loaded"):
+        findings.append(f"the later session did not load the snapshot (hit={r.get('hit')})")
+
+    print()
+    for f in findings:
+        print(f"  ! {f}")
+    print(f"  total: {len(findings)} finding(s)")
+    return 1 if findings else 0
+
+if __name__ == "__main__":
+    sys.exit(main())
