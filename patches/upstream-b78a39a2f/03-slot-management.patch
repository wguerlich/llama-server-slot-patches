diff --git a/tools/server/server-analyzer.h b/tools/server/server-analyzer.h
new file mode 100644
index 0000000..a8052fd
--- /dev/null
+++ b/tools/server/server-analyzer.h
@@ -0,0 +1,1415 @@
+#pragma once
+
+// [ANALYZER] in-band snapshot hints.
+//
+// A recursive harness knows things about its own conversation that the server can only guess at:
+// where it will resume, which position is worth persisting, and where the turn boundaries are when
+// the whole history is wrapped in a single message. This channel lets it say so, in-band, without
+// any API change - and without the model ever seeing it.
+//
+// Grammar. One marker per occurrence, anywhere in the text:
+//
+//   <<llama-snap enable secret=S>>                  system/developer message: unlocks the channel
+//   <<llama-snap snap  secret=S [at=A] [off=N]>>    persistent snapshot at that position
+//   <<llama-snap ckpt  secret=S [at=A] [off=N]>>    pinned context checkpoint at that position
+//
+//   A := user | agent | tool, optionally followed by -N   (N counts back, default 0)
+//   at= absent  -> the marker addresses ITSELF: the position it stood at
+//   off=N       -> shift the resolved position by N tokens (default 0)
+//
+// Why a secret. The activation marker sits in the system prompt, which the harness operator
+// controls; hints sit in user messages, which may carry content the operator does not control.
+// Requiring the secret from the system prompt means injected text in a user message cannot
+// fabricate a hint. The activation marker is stripped as well, so the secret never reaches the
+// model and cannot be echoed back to a user.
+//
+// Stripping is deterministic and total: every marker is removed, including rejected and malformed
+// ones, so a marker can never reach the model. A marker alone on its line takes the line with it,
+// otherwise only the marker text goes. That rule is what makes a harness WITH this channel produce
+// the same token stream as one without - if it did not, the shared prefix cache would fragment on
+// exactly the sessions this feature is for.
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// `json` comes from the including translation unit (server-common.h); this header is only ever
+// included from there, so it does not define its own alias.
+
+namespace server_analyzer {
+
+enum hint_kind {
+    HINT_SNAP = 0,   // persistent, goes to disk
+    HINT_CKPT = 1,   // volatile, pinned in the slot
+};
+
+enum hint_anchor {
+    ANCHOR_INLINE = 0,   // the position the marker itself stood at
+    ANCHOR_USER   = 1,
+    ANCHOR_AGENT  = 2,
+    ANCHOR_TOOL   = 3,
+};
+
+static const char * hint_kind_name(hint_kind k) {
+    return k == HINT_SNAP ? "snap" : "ckpt";
+}
+
+static const char * hint_anchor_name(hint_anchor a) {
+    switch (a) {
+        case ANCHOR_USER:  return "user";
+        case ANCHOR_AGENT: return "agent";
+        case ANCHOR_TOOL:  return "tool";
+        default:           return "inline";
+    }
+}
+
+struct hint {
+    hint_kind   kind   = HINT_SNAP;
+    hint_anchor anchor = ANCHOR_INLINE;
+    int32_t     back   = 0;    // N in at=role-N
+    int32_t     off    = 0;    // token offset applied after resolution
+
+    // where the marker stood, filled while scanning
+    size_t      msg_idx  = 0;  // index into messages[]
+    size_t      part_idx = 0;  // index of the TEXT PART it stood in (0 for string content).
+                               // Multipart matters: a message can be [image, text], and anchoring
+                               // on the wrong part puts the position inside the image - measured,
+                               // where snapshot_align_media then pulled it back to the image start.
+    size_t      char_off = 0;  // offset inside that part's stripped text
+
+    // resolved against the rendered prompt; -1 = not resolved
+    int64_t     render_off = -1;
+    // the exact token position, from comparing token streams - never from measuring characters
+    int64_t     tokens_to_end = -1;  // distance from the END of the prompt, in tokens
+
+    // at=agent with no assistant message yet: the position is the end of the generation that this
+    // request is about to produce. it cannot be resolved now - it is resolved when generation ends.
+    bool        pending_generation = false;
+
+    // Where the marker STANDS decides how much it is worth. A marker in a message after the last
+    // assistant turn is the harness's current statement about where it will resume - that one is
+    // acted on in full, roll-back included. A marker carried along in an earlier message is history:
+    // the conversation has moved past it, and the only thing it can still be good for is a fork
+    // back to that turn. Such a hint keeps an existing checkpoint alive (softly) but never buys one
+    // back with a re-prefill. Measured with the two conflated: markers carried in history re-pinned
+    // every old position each turn, the cap evicted them as PINNED, and the next turn rolled back 82
+    // tokens to re-create a checkpoint nobody was going to resume at.
+    bool        live = true;
+
+    std::string why_unresolved;   // telemetry only
+};
+
+struct result {
+    bool                activated = false;
+    std::string         secret;
+    std::vector<hint>   hints;
+    int32_t             n_markers  = 0;   // markers seen, valid or not
+    int32_t             n_rejected = 0;
+    std::string         reject;           // reason of the FIRST rejection, for the journal
+};
+
+// ---------------------------------------------------------------------------------------------
+// marker scanning
+// ---------------------------------------------------------------------------------------------
+
+static const char * MARKER_OPEN  = "<<llama-snap";
+static const char * MARKER_CLOSE = ">>";
+
+struct parsed_marker {
+    std::string verb;                                  // enable | snap | ckpt
+    std::string secret;
+    std::string at;                                    // empty = inline
+    int32_t     off = 0;
+    bool        ok  = false;
+    std::string err;
+};
+
+// split "k=v k=v" after the verb. values are whitespace-free; anything else is a malformed marker,
+// which is rejected but still stripped.
+static parsed_marker parse_marker_body(const std::string & body) {
+    parsed_marker m;
+
+    size_t i = 0;
+    auto skip_ws = [&]() { while (i < body.size() && isspace((unsigned char) body[i])) ++i; };
+
+    skip_ws();
+    size_t v0 = i;
+    while (i < body.size() && !isspace((unsigned char) body[i])) ++i;
+    m.verb = body.substr(v0, i - v0);
+
+    if (m.verb != "enable" && m.verb != "snap" && m.verb != "ckpt") {
+        m.err = "unknown verb '" + m.verb + "'";
+        return m;
+    }
+
+    bool have_off = false;
+    while (true) {
+        skip_ws();
+        if (i >= body.size()) break;
+        size_t k0 = i;
+        while (i < body.size() && body[i] != '=' && !isspace((unsigned char) body[i])) ++i;
+        const std::string key = body.substr(k0, i - k0);
+        if (i >= body.size() || body[i] != '=') {
+            m.err = "expected key=value, got '" + key + "'";
+            return m;
+        }
+        ++i; // '='
+        size_t v1 = i;
+        while (i < body.size() && !isspace((unsigned char) body[i])) ++i;
+        const std::string val = body.substr(v1, i - v1);
+
+        if (key == "secret") {
+            m.secret = val;
+        } else if (key == "at") {
+            m.at = val;
+        } else if (key == "off") {
+            try {
+                m.off = std::stoi(val);
+                have_off = true;
+            } catch (...) {
+                m.err = "off is not a number: '" + val + "'";
+                return m;
+            }
+        } else {
+            m.err = "unknown key '" + key + "'";
+            return m;
+        }
+    }
+    (void) have_off;
+
+    if (m.secret.empty()) {
+        m.err = "missing secret";
+        return m;
+    }
+
+    m.ok = true;
+    return m;
+}
+
+// at=user / at=agent-2 / at=tool-1
+static bool parse_anchor(const std::string & s, hint_anchor & a, int32_t & back, std::string & err) {
+    std::string role = s;
+    back = 0;
+
+    const size_t dash = s.find('-');
+    if (dash != std::string::npos) {
+        role = s.substr(0, dash);
+        try {
+            back = std::stoi(s.substr(dash + 1));
+        } catch (...) {
+            err = "at: '" + s.substr(dash + 1) + "' is not a number";
+            return false;
+        }
+        if (back < 0) {
+            err = "at: N must not be negative";
+            return false;
+        }
+    }
+
+    if (role == "user")       a = ANCHOR_USER;
+    else if (role == "agent") a = ANCHOR_AGENT;
+    else if (role == "tool")  a = ANCHOR_TOOL;
+    else {
+        err = "at: unknown role '" + role + "'";
+        return false;
+    }
+    return true;
+}
+
+// Remove one marker from `text` at [pos, end). If the marker is alone on its line, the whole line
+// including its trailing newline goes; otherwise only the marker text. Returns the offset at which
+// the marker stood in the RESULTING text - which is where an inline hint points.
+static size_t strip_marker(std::string & text, size_t pos, size_t end) {
+    size_t ls = text.rfind('\n', pos == 0 ? 0 : pos - 1);
+    ls = (ls == std::string::npos) ? 0 : ls + 1;
+    size_t le = text.find('\n', end);
+
+    const bool only_ws_before = text.find_first_not_of(" \t\r", ls) >= pos;
+    const size_t after = end;
+    const size_t line_tail_end = (le == std::string::npos) ? text.size() : le;
+    const bool only_ws_after = text.find_first_not_of(" \t\r", after) >= line_tail_end;
+
+    if (only_ws_before && only_ws_after) {
+        // The marker owned the line, so the line goes. Which newline goes with it depends on where
+        // the line sits: a line in the middle takes the one that ends it, the LAST line takes the one
+        // that starts it. Either way what remains is exactly what a harness without this channel
+        // would have sent - which is the whole point, see the note on prefix identity above.
+        if (le == std::string::npos) {
+            const size_t cut_start = ls > 0 ? ls - 1 : 0;
+            text.erase(cut_start, text.size() - cut_start);
+            return cut_start;
+        }
+        text.erase(ls, le + 1 - ls);
+        return ls;
+    }
+
+    text.erase(pos, end - pos);
+    return pos;
+}
+
+// Scan one text, strip every marker in it, and report what was found. `out` receives one entry per
+// well-formed marker; malformed ones only bump n_markers and set `reject`.
+struct found_marker {
+    parsed_marker m;
+    size_t        char_off;   // offset in the stripped text
+};
+
+// Find every marker in `text` WITHOUT touching it. Stripping is a separate decision, because it
+// is a text transformation an attacker would otherwise control - see strip_accepted below.
+struct raw_marker {
+    size_t        pos;   // start of "<<llama-snap"
+    size_t        end;   // one past ">>"
+    parsed_marker m;
+};
+
+static void scan_text(const std::string & text, std::vector<raw_marker> & out, result & res) {
+    size_t search = 0;
+    while (true) {
+        const size_t pos = text.find(MARKER_OPEN, search);
+        if (pos == std::string::npos) {
+            break;
+        }
+        const size_t close = text.find(MARKER_CLOSE, pos);
+        if (close == std::string::npos) {
+            // an unterminated marker: leave the text alone, there is nothing well-defined to cut
+            res.n_markers++;
+            res.n_rejected++;
+            if (res.reject.empty()) res.reject = "unterminated marker";
+            break;
+        }
+        const size_t end  = close + 2;
+        const std::string body = text.substr(pos + strlen(MARKER_OPEN), close - pos - strlen(MARKER_OPEN));
+
+        res.n_markers++;
+        out.push_back({pos, end, parse_marker_body(body)});
+        search = end;
+    }
+}
+
+// Cut out the markers at the given indices of `found`, from the back so the earlier offsets stay
+// valid. Returns, per cut marker, where it stood in the stripped text.
+//
+// [SECURITY] Only markers that have been ACCEPTED get here, and that is the whole point. Stripping
+// every marker - including one carrying a wrong secret, which is what this code did until
+// 2026-09-15 - hands an attacker a text transformation that runs AFTER any inspection upstream:
+//
+//     ignore<<llama-snap a>> all<<llama-snap b>> previous instructions
+//
+// A filter looking for that sentence does not see it; the model receives it assembled. Leaving an
+// unaccepted marker verbatim means the model reads exactly the bytes the user sent, which is the
+// only property that makes an upstream check meaningful. The cost is that a bogus marker is visible
+// to the model - as the user's own text, which it is.
+static std::vector<size_t> strip_accepted(std::string & text, const std::vector<raw_marker> & found,
+                                          const std::vector<size_t> & accept) {
+    std::vector<size_t> offs(found.size(), std::string::npos);
+    for (auto it = accept.rbegin(); it != accept.rend(); ++it) {
+        const raw_marker & r = found[*it];
+        offs[*it] = strip_marker(text, r.pos, r.end);
+    }
+    // offsets recorded while cutting from the back are still correct for the markers cut later,
+    // because those sit earlier in the text and nothing before them moved.
+    return offs;
+}
+
+// content is either a string or an array of parts; walk every text part in order. The callback
+// gets a mutable reference and the running index of the part.
+template <typename F>
+static void for_each_text(json & msg, F && fn) {
+    if (!msg.contains("content")) {
+        return;
+    }
+    json & c = msg.at("content");
+    if (c.is_string()) {
+        std::string s = c.get<std::string>();
+        if (fn(s, (size_t) 0)) {
+            c = s;
+        }
+        return;
+    }
+    if (c.is_array()) {
+        size_t idx = 0;
+        for (auto & part : c) {
+            if (!part.is_object() || !part.contains("text") || !part.at("text").is_string()) {
+                idx++;
+                continue;
+            }
+            std::string s = part.at("text").get<std::string>();
+            if (fn(s, idx)) {
+                part["text"] = s;
+            }
+            idx++;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// the entry point: two passes over messages[], stripping as it goes
+// ---------------------------------------------------------------------------------------------
+//
+// Pass 1 looks at system/developer messages only, for the activation. Pass 2 takes hints from the
+// remaining messages, accepting only those whose secret matches. Both passes strip unconditionally:
+// a marker never survives either pass, whatever its fate.
+//
+static result scan_and_strip(json & messages) {
+    result res;
+
+    // --- pass 1: activation (system / developer) ---
+    for (auto & msg : messages) {
+        const std::string role = msg.contains("role") && msg.at("role").is_string()
+                               ? msg.at("role").get<std::string>() : std::string();
+        if (role != "system" && role != "developer") {
+            continue;
+        }
+        for_each_text(msg, [&](std::string & text, size_t /*part_idx*/) {
+            if (text.find(MARKER_OPEN) == std::string::npos) {
+                return false;
+            }
+            std::vector<raw_marker> fs;
+            scan_text(text, fs, res);
+            std::vector<size_t> accept;
+            for (size_t k = 0; k < fs.size(); ++k) {
+                if (fs[k].m.ok && fs[k].m.verb == "enable") {
+                    res.activated = true;
+                    res.secret    = fs[k].m.secret;
+                    accept.push_back(k);   // the harness wrote this, and it carries the secret
+                } else {
+                    // a hint in the system prompt is not what the channel is for: the system prompt
+                    // is the same every turn, so a position in it is not a conversation position.
+                    res.n_rejected++;
+                    if (res.reject.empty()) res.reject = fs[k].m.ok ? "hint in a system message" : fs[k].m.err;
+                }
+            }
+            if (accept.empty()) {
+                return false;
+            }
+            strip_accepted(text, fs, accept);
+            return true;
+        });
+    }
+
+    // --- pass 2: hints (everything else) ---
+    // The LEADING system block is excluded: it is the same every turn, so a position in it is not a
+    // conversation position. A system or developer message that arrives mid-conversation is one -
+    // modern harnesses steer that way, and it is exactly where such a harness would put its marker.
+    int64_t last_assistant = -1;
+    size_t  first_non_sys  = 0;
+    for (size_t i = 0; i < messages.size(); ++i) {
+        const auto & m = messages[i];
+        const std::string role = m.contains("role") && m.at("role").is_string() ? m.at("role").get<std::string>() : std::string();
+        if (role == "assistant") {
+            last_assistant = (int64_t) i;
+        }
+        if (first_non_sys == i && (role == "system" || role == "developer")) {
+            first_non_sys = i + 1;
+        }
+    }
+    for (size_t i = 0; i < messages.size(); ++i) {
+        auto & msg = messages[i];
+        const std::string role = msg.contains("role") && msg.at("role").is_string()
+                               ? msg.at("role").get<std::string>() : std::string();
+        if ((role == "system" || role == "developer") && i < first_non_sys) {
+            continue;
+        }
+        for_each_text(msg, [&](std::string & text, size_t part_idx) {
+            if (text.find(MARKER_OPEN) == std::string::npos) {
+                return false;
+            }
+            std::vector<raw_marker> fs;
+            scan_text(text, fs, res);
+
+            // Decide FIRST, cut afterwards, and only what was accepted. A marker that does not
+            // prove itself stays in the text exactly as the user wrote it - see strip_accepted.
+            std::vector<size_t> accept;
+            std::vector<hint>   made;
+            for (size_t k = 0; k < fs.size(); ++k) {
+                const parsed_marker & m = fs[k].m;
+                if (!m.ok) {
+                    res.n_rejected++;
+                    if (res.reject.empty()) res.reject = m.err;
+                    continue;
+                }
+                if (m.verb == "enable") {
+                    res.n_rejected++;
+                    if (res.reject.empty()) res.reject = "enable outside the system prompt";
+                    continue;
+                }
+                if (!res.activated) {
+                    res.n_rejected++;
+                    if (res.reject.empty()) res.reject = "no activation in this request";
+                    continue;
+                }
+                if (m.secret != res.secret) {
+                    res.n_rejected++;
+                    if (res.reject.empty()) res.reject = "secret mismatch";
+                    continue;
+                }
+
+                hint h;
+                h.kind     = (m.verb == "ckpt") ? HINT_CKPT : HINT_SNAP;
+                h.off      = m.off;
+                h.msg_idx  = i;
+                h.part_idx = part_idx;
+                h.live     = (int64_t) i > last_assistant;
+
+                if (!m.at.empty()) {
+                    std::string err;
+                    if (!parse_anchor(m.at, h.anchor, h.back, err)) {
+                        res.n_rejected++;
+                        if (res.reject.empty()) res.reject = err;
+                        continue;
+                    }
+                } else {
+                    h.anchor = ANCHOR_INLINE;
+                }
+                accept.push_back(k);
+                made.push_back(h);
+            }
+
+            if (accept.empty()) {
+                return false;
+            }
+            const std::vector<size_t> offs = strip_accepted(text, fs, accept);
+            for (size_t j = 0; j < accept.size(); ++j) {
+                made[j].char_off = offs[accept[j]];
+                res.hints.push_back(made[j]);
+            }
+            return true;
+        });
+    }
+
+    return res;
+}
+
+// ---------------------------------------------------------------------------------------------
+// exact positions
+// ---------------------------------------------------------------------------------------------
+//
+// A position is a TOKEN position - that is what a checkpoint, a snapshot and a prefill all count in.
+// Converting a character offset into one by measuring token pieces means deciding what to do when
+// the offset falls inside a token, and every such decision is a rounding. So we do not convert: we
+// tokenise both sides and take the length of their common token prefix. That is exact by
+// construction, and it is also the only formulation that catches the re-tokenisation seam - two
+// strings can share a character prefix and still tokenise differently across it, which is precisely
+// the case that costs a whole prompt.
+
+static int32_t token_prefix_len(const llama_tokens & a, const llama_tokens & b) {
+    const size_t n = std::min(a.size(), b.size());
+    size_t i = 0;
+    while (i < n && a[i] == b[i]) {
+        ++i;
+    }
+    return (int32_t) i;
+}
+
+// [PROBE] How many tokens from the END of `a` does it part from `b`?
+//
+// Both strings share a long prefix and differ near their end, so tokenising them whole to find that
+// out is wasteful: at 159k tokens one pass costs 190 ms and the probe needs several (measured on
+// this machine). And with media in the prompt it is not merely wasteful but wrong - a plain
+// common_tokenize cannot reproduce a stream that interleaves image chunks, which is why media
+// prompts were excluded from positioning altogether.
+//
+// Counting from the END removes both problems. Find where the two strings part in CHARACTERS, then
+// tokenise only a window ending at that point - the same window in both, since they are identical
+// inside it. The count that comes out is an offset from the end, and the absolute position follows
+// from the server's own token count for the prompt, which does know about media.
+//
+// The window has to be wide enough that whatever the tokeniser does at its ragged start cannot
+// reach the seam. It is a suffix of a longer text, so its first token may well be cut differently
+// than it would be in the full stream; that error stays at the start and cancels, because both the
+// window's length and the common prefix within it are measured in the SAME tokenisation. A few
+// thousand characters is far more slack than any merge needs.
+//
+// Returns -1 when the two do not differ at all (a pure append), or when the window cannot be built.
+//
+// `media_marker`, when set, refuses a seam with media between it and the end of `a`: those tokens
+// would be counted as their marker text instead of their real length, and the caller would place a
+// checkpoint at a position that exists in no real stream. The hints have had this check from the
+// start (resolve_tokens); the probe went without it.
+//
+// `memo` caches the tokenisation of `a`'s window by its start. Two futures that part at the same
+// character (user_think / user_nothink under a template that strips both) share one pass - which
+// matters, because a seam far behind the end makes that pass as long as the distance to the end.
+static int64_t tail_divergence(const llama_vocab * vocab, const std::string & a, const std::string & b,
+                               size_t window_chars, const std::string & media_marker,
+                               std::map<size_t, llama_tokens> & memo) {
+    // where they part, in characters
+    const size_t m = std::min(a.size(), b.size());
+    size_t c = 0;
+    while (c < m && a[c] == b[c]) {
+        ++c;
+    }
+    if (c == a.size() && a.size() == b.size()) {
+        return -1;               // identical
+    }
+    if (!media_marker.empty() && a.find(media_marker, c) != std::string::npos) {
+        return -1;               // media between the seam and the end: not countable here
+    }
+    // NOT an early "pure append" here, even when `b` contains `a` character for character. The last
+    // token of `a` is cut differently once something follows it - `...model\n` alone is not the same
+    // token as `...model\n` with an answer behind it - so a continuation that only appends can still
+    // part one token before the end. Measured on Gemma: character-wise a pure append, token-wise a
+    // divergence at 129 of 130. Returning 0 here hid that and the probe placed nothing at all.
+    // The window comparison below answers it correctly in both cases: 0 for a true append, 1 here.
+
+    const size_t beg = c > window_chars ? c - window_chars : 0;
+    auto it = memo.find(beg);
+    if (it == memo.end()) {
+        it = memo.emplace(beg, common_tokenize(vocab, a.substr(beg), true, true)).first;
+    }
+    const llama_tokens & ta = it->second;
+    const llama_tokens   tb = common_tokenize(vocab, b.substr(beg), true, true);
+
+    const int32_t shared = token_prefix_len(ta, tb);
+    return (int64_t) ta.size() - shared;   // tokens of `a` beyond the parting point
+}
+
+// [ANALYZER] How many tokens lie between `char_off` and the END of the render?
+//
+// Same construction as tail_divergence, and for the same two reasons: it costs a window rather
+// than the whole prompt, and it survives MEDIA. A prompt with an image cannot be tokenised by
+// this code at all - the real stream interleaves image chunks that a plain call does not
+// reproduce - so an absolute position derived here would point into the wrong sequence. A
+// distance from the end does not: the server adds its own token count, which knows about them.
+//
+// The one thing that must hold is that no media sits BETWEEN the position and the end, because
+// those tokens would be counted as their marker text instead of their real length. That is
+// checked by the caller against the marker in the render, and a hint that fails it is refused
+// with a reason rather than silently misplaced.
+//
+// Returns -1 when the offset is outside the render.
+static int64_t tokens_to_end(const llama_vocab * vocab, const std::string & render,
+                             size_t char_off, size_t window_chars) {
+    if (char_off > render.size()) {
+        return -1;
+    }
+    const size_t beg = char_off > window_chars ? char_off - window_chars : 0;
+    const llama_tokens all = common_tokenize(vocab, render.substr(beg), true, true);
+    const llama_tokens pre = common_tokenize(vocab, render.substr(beg, char_off - beg), true, true);
+    const int32_t shared = token_prefix_len(all, pre);
+    return (int64_t) all.size() - shared;
+}
+
+// how many leading tokens of `full` survive when the render is cut at `char_off`
+static int32_t exact_pos_at_cut(const llama_vocab * vocab, const llama_tokens & full,
+                                const std::string & render, size_t char_off) {
+    if (char_off > render.size()) {
+        return -1;
+    }
+    const llama_tokens cut = common_tokenize(vocab, render.substr(0, char_off), true, true);
+    return token_prefix_len(full, cut);
+}
+
+// ---------------------------------------------------------------------------------------------
+// resolving a hint against the rendered prompt
+// ---------------------------------------------------------------------------------------------
+//
+// The template is the only thing that knows how a message becomes text, so we do not model it - we
+// look for the message's own (already stripped) text in the render and take the end of the match.
+// That is a single string search on top of the render that happens anyway, and it is exactly as
+// correct as the assumption that a template reproduces message content verbatim. Where it does not,
+// the search misses and the hint is reported unresolved rather than placed somewhere wrong.
+//
+// A short content would match in many places, so a match is only accepted when it is UNIQUE in the
+// render. Ambiguity is a miss, not a guess.
+
+// the longest text part of a message, which is what we look for in the render
+// Every text part of a message, in order, each with its index. A message is [image, text] often
+// enough that taking "the longest one" is not good enough: the marker stood in ONE of them, and
+// anchoring on another puts the position on the wrong side of the image.
+struct text_part {
+    size_t      idx;
+    std::string text;
+};
+
+static std::vector<text_part> message_text_parts(const json & msg) {
+    std::vector<text_part> out;
+    if (!msg.contains("content")) {
+        return out;
+    }
+    const json & c = msg.at("content");
+    if (c.is_string()) {
+        out.push_back({0, c.get<std::string>()});
+        return out;
+    }
+    if (c.is_array()) {
+        size_t idx = 0;
+        for (const auto & part : c) {
+            if (part.is_object() && part.contains("text") && part.at("text").is_string()) {
+                out.push_back({idx, part.at("text").get<std::string>()});
+            }
+            idx++;
+        }
+    }
+    return out;
+}
+
+// find `needle` in `hay`, requiring it to be unique. returns npos on miss or ambiguity.
+// Locate every message's text in the render, IN ORDER.
+//
+// A template emits the messages in the order it was given them, so the k-th message's text sits at
+// or after the end of the (k-1)-th. Walking with a cursor therefore resolves what a global
+// uniqueness test has to give up on: two identical tool results, the same question asked twice, a
+// harness that repeats "continue". Those are not exotic - they are the everyday shape of the agent
+// loops this channel exists for.
+//
+// A message that cannot be found at all leaves the cursor where it was and is simply marked
+// unresolved: a template is free to drop a message, and guessing past that point would be worse
+// than admitting it. Whitespace around a message may be trimmed by the template, so a probe that
+// does not appear verbatim is retried right-trimmed.
+struct msg_span {
+    int64_t beg = -1;
+    int64_t end = -1;
+};
+
+static std::map<std::pair<size_t, size_t>, msg_span>
+locate_parts(const json & messages, const std::string & render) {
+    std::map<std::pair<size_t, size_t>, msg_span> out;
+    size_t cursor = 0;
+    for (size_t i = 0; i < messages.size(); ++i) {
+        for (const auto & tp : message_text_parts(messages[i])) {
+            std::string probe = tp.text;
+            if (probe.empty()) {
+                continue;
+            }
+            size_t at = render.find(probe, cursor);
+            if (at == std::string::npos) {
+                const size_t e = probe.find_last_not_of(" \t\r\n");
+                if (e == std::string::npos) {
+                    continue;
+                }
+                probe = probe.substr(0, e + 1);
+                at    = render.find(probe, cursor);
+            }
+            if (at == std::string::npos) {
+                continue;
+            }
+            msg_span sp;
+            sp.beg = (int64_t) at;
+            sp.end = (int64_t) (at + probe.size());
+            out[{i, tp.idx}] = sp;
+            cursor = at + probe.size();
+        }
+    }
+    return out;
+}
+
+// The span of a whole message, for the role anchors: from the first of its parts to the last.
+static msg_span message_span(const std::map<std::pair<size_t, size_t>, msg_span> & at, size_t msg) {
+    msg_span sp;
+    for (const auto & kv : at) {
+        if (kv.first.first != msg) {
+            continue;
+        }
+        if (sp.beg < 0 || kv.second.beg < sp.beg) sp.beg = kv.second.beg;
+        if (kv.second.end > sp.end)               sp.end = kv.second.end;
+    }
+    return sp;
+}
+
+// Resolve every hint to a character offset in `render`. `messages` must be the STRIPPED array that
+// produced the render.
+static void resolve(std::vector<hint> & hints, const json & messages, const std::string & render) {
+    const auto at = locate_parts(messages, render);
+
+    for (auto & h : hints) {
+        h.render_off = -1;
+
+        if (h.anchor == ANCHOR_INLINE) {
+            const auto it = at.find({h.msg_idx, h.part_idx});
+            if (it == at.end()) {
+                h.why_unresolved = "message text not found in render";
+                continue;
+            }
+            const int64_t len = it->second.end - it->second.beg;
+            h.render_off = it->second.beg + std::min<int64_t>((int64_t) h.char_off, len);
+            continue;
+        }
+
+        // role anchors: count back through the messages of that role
+        const char * want = h.anchor == ANCHOR_USER  ? "user"
+                          : h.anchor == ANCHOR_AGENT ? "assistant"
+                                                     : "tool";
+        std::vector<size_t> idx;
+        for (size_t i = 0; i < messages.size(); ++i) {
+            const auto & m = messages[i];
+            if (m.contains("role") && m.at("role").is_string() && m.at("role").get<std::string>() == want) {
+                idx.push_back(i);
+            }
+        }
+
+        // at=agent with nothing generated yet: the position is the end of the answer this request is
+        // about to produce. Resolvable only when generation ends, so it is handed on as pending.
+        if (h.anchor == ANCHOR_AGENT && h.back == 0 &&
+            (idx.empty() || idx.back() + 1 != messages.size())) {
+            h.pending_generation = true;
+            continue;
+        }
+
+        if ((int32_t) idx.size() <= h.back) {
+            h.why_unresolved = "no such message: only " + std::to_string(idx.size()) + " of that role";
+            continue;
+        }
+        const msg_span sp = message_span(at, idx[idx.size() - 1 - h.back]);
+        if (sp.end < 0) {
+            h.why_unresolved = "message text not found in render";
+            continue;
+        }
+        h.render_off = sp.end;
+    }
+}
+
+// [ANALYZER] How many tokens lie between `char_off` and the END of the render?
+//
+// Same construction as tail_divergence, and for the same two reasons: it costs a window rather
+// than the whole prompt, and it survives MEDIA. A prompt with an image cannot be tokenised by
+// this code at all - the real stream interleaves image chunks that a plain call does not
+// reproduce - so an absolute position derived here would point into the wrong sequence. A
+// distance from the end does not: the server adds its own token count, which knows about them.
+//
+// The one thing that must hold is that no media sits BETWEEN the position and the end, because
+// those tokens would be counted as their marker text instead of their real length. That is
+// checked by the caller against the marker in the render, and a hint that fails it is refused
+// with a reason rather than silently misplaced.
+//
+// Returns -1 when the offset is outside the render.
+
+// Turn the resolved character offsets into exact token positions. Same construction as the probe:
+// cut the render there, tokenise, and take the common token prefix with the real prompt. No
+// character-to-token arithmetic, so no rounding and no offset that lands inside a token.
+static void resolve_tokens(std::vector<hint> & hints, const llama_vocab * vocab,
+                           const std::string & render, const std::string & media_marker,
+                           size_t window_chars) {
+    for (auto & h : hints) {
+        if (h.pending_generation || h.render_off < 0) {
+            continue;
+        }
+
+        // media between here and the end would be counted as its marker text, not its real
+        // length. Media BEFORE the position is fine - nothing behind it is being counted.
+        if (!media_marker.empty() &&
+            render.find(media_marker, (size_t) h.render_off) != std::string::npos) {
+            h.why_unresolved = "media between the position and the end of the prompt";
+            continue;
+        }
+
+        const int64_t to_end = tokens_to_end(vocab, render, (size_t) h.render_off, window_chars);
+        if (to_end < 0) {
+            h.why_unresolved = "offset outside the render";
+            continue;
+        }
+
+        // [SEAM] one token further from the end than declared, deliberately.
+        //
+        // A hint names a position in CHARACTERS; a checkpoint lives at a TOKEN boundary, and the
+        // token that spans the seam is not determined by the text before it alone - it depends on
+        // what follows, which is precisely the part that has not been written yet. Measured: a
+        // harness marks the end of its turn right after "</user>"; the cut tokenises to 31 and the
+        // next turn, which continues "</user><think>", parts from this one at 30 - the shared
+        // stretch ends INSIDE the closing tag. A checkpoint at 31 then sits one token beyond the
+        // divergence and is useless for the roll-back it exists for, while one at 30 costs a
+        // single extra token of prefill and always works.
+        //
+        // So the declared position is an upper bound, not an exact one. This is the same seam that
+        // once sent fifteen turns of a session into full prefill; it cannot be computed away, only
+        // kept on the safe side of.
+        h.tokens_to_end = to_end + 1;
+    }
+}
+
+// one compact line per hint, for the journal
+static std::string describe(const hint & h) {
+    std::string s = std::string(hint_kind_name(h.kind)) + " at=" + hint_anchor_name(h.anchor);
+    if (h.anchor != ANCHOR_INLINE && h.back > 0) {
+        s += "-" + std::to_string(h.back);
+    }
+    if (h.off != 0) {
+        s += " off=" + std::to_string(h.off);
+    }
+    if (!h.live) {
+        s += " (historic)";
+    }
+    if (h.pending_generation) {
+        s += " -> end of generation";
+    } else if (h.tokens_to_end >= 0) {
+        s += " -> " + std::to_string(h.tokens_to_end) + " tokens before the end";
+    } else if (h.render_off >= 0) {
+        s += " -> char " + std::to_string(h.render_off) + " (no token position)";
+    } else {
+        s += " -> UNRESOLVED (" + h.why_unresolved + ")";
+    }
+    return s;
+}
+
+// ---------------------------------------------------------------------------------------------
+// [PROBE] where will the NEXT prompt of this conversation diverge from this one?
+// ---------------------------------------------------------------------------------------------
+//
+// That question decides where a checkpoint is worth its 600 MiB, and it cannot be answered by
+// looking at this request alone: it depends on what the template does with the history of a LATER
+// turn. A template that carries reasoning forward makes the next prompt a pure append; one that
+// strips it rewrites the turn that just happened, and the next prompt diverges somewhere behind us.
+//
+// So we do not reason about it, we render it. Take the inputs of this request, append a dummy
+// assistant answer and a dummy continuation, render again, and compare: the first byte where the two
+// renders differ IS the divergence point of the next request. No model runs - this is the Jinja
+// template and nothing else, twice, on a string we were going to build anyway.
+//
+// Two forms, because a template may branch on what follows:
+//   user  - the conversation continues with a new user turn
+//   tool  - the agent loop continues with a tool result (assistant carries a tool call)
+//
+// The dummy content is irrelevant; only its SHAPE matters, because that is all the template
+// branches on. The one shape we cannot invent is the harness's own habit of echoing reasoning back
+// or not - so that is observed from this request's history rather than assumed.
+
+struct divergence {
+    // Offsets from the END of this prompt, in tokens: 0 means the next prompt only appends (nothing
+    // to check-point, the live state is the resume point), -1 means the future did not render, and
+    // -2 (user_drop only) means the future is MOOT: no message carries reasoning, so "dropped the
+    // previous reasoning" renders exactly like user_think. A moot future does not make the candidate
+    // set incomplete - it is complete, one of its members just coincides with another.
+    int64_t user = -1;
+    int64_t tool = -1;
+    // The futures are named ABSOLUTELY, by what the next prompt will contain:
+    //   user_think    the next prompt carries the reasoning of this turn
+    //   user_nothink  it does not
+    //   user_drop     it has dropped the OLDEST reasoning still in the history
+    //   tool          a tool result follows instead of a user turn
+    bool    echoes_thinking = false;
+    bool    echo_known      = false;
+    int64_t user_think   = -1;
+    int64_t user_nothink = -1;
+    // user_drop is a RANGE: the position to place at is `user_drop` tokens before the end (one token
+    // before the opening reasoning tag), and the divergence itself lies before the first reasoning
+    // token, which is `user_drop_hi` tokens before the end. Everything in [drop, drop_hi) is a
+    // checkpoint the drop future can resume from.
+    int64_t user_drop    = -1;
+    int64_t user_drop_hi = -1;
+    // The template rewrites history behind the seam (Mistral: the system prompt travels with the
+    // LAST user message, so every turn re-renders the previous user turn). Structural answer: the
+    // rewrite happens inside the last user turn, so the divergence lies between the end of the
+    // message before it and the start of its text - a range, like the drop.
+    bool    rewrites_history = false;
+    int64_t rewrite    = -1;
+    int64_t rewrite_hi = -1;
+    int64_t us = 0;
+};
+
+struct think_marks {
+    std::string open;
+    std::string close;
+    bool        known = false;
+};
+
+static think_marks derive_think_marks(const struct common_chat_templates * tmpls) {
+    static std::mutex mu;
+    static std::map<const struct common_chat_templates *, think_marks> cache;
+    {
+        std::lock_guard<std::mutex> lk(mu);
+        auto it = cache.find(tmpls);
+        if (it != cache.end()) {
+            return it->second;
+        }
+    }
+
+    think_marks m;
+    const std::string sentinel = "zZqQreasoningSentinel42";
+
+    auto render = [&](bool with) -> std::string {
+        common_chat_templates_inputs in;
+        common_chat_msg u; u.role = "user";      u.content = "u";
+        common_chat_msg a; a.role = "assistant"; a.content = "a";
+        if (with) {
+            a.reasoning_content = sentinel;
+        }
+        in.messages.push_back(u);
+        in.messages.push_back(a);
+        in.use_jinja             = true;
+        in.add_generation_prompt = false;
+        try {
+            return common_chat_templates_apply(tmpls, in).prompt;
+        } catch (const std::exception &) {
+            return std::string();
+        }
+    };
+
+    const std::string with    = render(true);
+    const std::string without = render(false);
+    const size_t at = with.find(sentinel);
+
+    if (!with.empty() && !without.empty() && at != std::string::npos) {
+        // common prefix and suffix of the two renders bound the inserted block
+        size_t pre = 0;
+        while (pre < with.size() && pre < without.size() && with[pre] == without[pre]) {
+            ++pre;
+        }
+        size_t suf = 0;
+        while (suf < with.size() - pre && suf < without.size() - pre &&
+               with[with.size() - 1 - suf] == without[without.size() - 1 - suf]) {
+            ++suf;
+        }
+        const size_t beg = pre;
+        const size_t end = with.size() - suf;           // inserted stretch = [beg, end)
+        if (beg <= at && at + sentinel.size() <= end) {
+            m.open  = with.substr(beg, at - beg);
+            m.close = with.substr(at + sentinel.size(), end - (at + sentinel.size()));
+            m.known = !m.open.empty();
+        }
+    }
+
+    {
+        std::lock_guard<std::mutex> lk(mu);
+        cache[tmpls] = m;
+    }
+    LOG_DBG("[probe] reasoning wrapper for this template: %s\n",
+            m.known ? (("\"" + m.open + "\" ... \"" + m.close + "\"")).c_str() : "not derivable");
+    return m;
+}
+
+// Does this message carry reasoning, in either form? When it is inline, hand back where it sits so
+// it can be cut out for the "dropped the previous reasoning" future.
+static bool message_has_thinking(const common_chat_msg & m, const think_marks & tm,
+                                 size_t & beg, size_t & len) {
+    beg = std::string::npos;
+    len = 0;
+    if (!m.reasoning_content.empty()) {
+        return true;
+    }
+    if (!tm.known || m.content.empty()) {
+        return false;
+    }
+    const size_t o = m.content.find(tm.open);
+    if (o == std::string::npos) {
+        return false;
+    }
+    size_t e;
+    if (tm.close.empty()) {
+        e = m.content.size();
+    } else {
+        const size_t c = m.content.find(tm.close, o + tm.open.size());
+        if (c == std::string::npos) {
+            return false;
+        }
+        e = c + tm.close.size();
+    }
+    beg = o;
+    len = e - o;
+    return true;
+}
+
+// `marks` may carry the reasoning tags the chat format already knows (common_chat_params'
+// thinking_start_tag / thinking_end_tags). Preferred over deriving them, because the derivation
+// fails on every template that emits the wrapper even for EMPTY reasoning - the inserted stretch is
+// then exactly the sentinel and the wrapper looks empty. Measured on the production template:
+// "<think>\n" ... "\n</think>" rendered around empty reasoning, derived wrapper "" -> not known.
+// `media_marker`, when non-empty, refuses seams with media behind them (see tail_divergence).
+// [PROBE] What this template does at the seam - measured ONCE per template (and per enable_thinking
+// value): the only renders the probe still does. Nothing is rendered per request.
+//
+// The near-end futures (this turn's answer rendered with / without reasoning, a tool result
+// following) part from the current prompt at a distance that depends on the template alone: the
+// generation prompt, the assistant header, the reasoning wrapper. Nothing in the conversation
+// content moves it. So it is rendered once, on a two-message dummy conversation, and cached.
+//
+// The one thing a template can do that no fixed offset captures is rewrite what came BEFORE the
+// seam once another message follows - the Mistral family attaches the system prompt to the LAST
+// user message, so every turn moves it. That is detected here too: if the dummy future parts from
+// the base before the end of the base's user text, the template rewrites history, and the probe adds
+// the last user turn as a structural candidate range (see probe()).
+struct template_traits {
+    bool    ok               = false;
+    bool    rewrites_history = false;
+    int64_t off_think        = -1;
+    int64_t off_nothink      = -1;
+    int64_t off_tool_think   = -1;   // a tool result follows an answer that carries its reasoning
+    int64_t off_tool_nothink = -1;   // ... or one that does not
+};
+
+static template_traits template_traits_for(const struct common_chat_templates * tmpls,
+                                           const llama_vocab * vocab,
+                                           const common_chat_templates_inputs & like,
+                                           size_t window_chars) {
+    static std::mutex mu;
+    static std::map<std::pair<const void *, int>, template_traits> cache;
+    const std::pair<const void *, int> key = {(const void *) tmpls, like.enable_thinking ? 1 : 0};
+    {
+        std::lock_guard<std::mutex> lk(mu);
+        auto it = cache.find(key);
+        if (it != cache.end()) {
+            return it->second;
+        }
+    }
+
+    template_traits t;
+
+    common_chat_templates_inputs in;
+    in.use_jinja              = true;
+    in.enable_thinking        = like.enable_thinking;
+    in.reasoning_format       = like.reasoning_format;
+    in.chat_template_kwargs   = like.chat_template_kwargs;
+    in.add_generation_prompt  = true;
+    in.continue_final_message = COMMON_CHAT_CONTINUATION_NONE;
+
+    const std::string X = "probe-first-question-Qz7 about nothing in particular";
+    common_chat_msg sm; sm.role = "system"; sm.content = "probe-system-prompt";
+    common_chat_msg um; um.role = "user";   um.content = X;
+    in.messages = {sm, um};
+
+    auto render = [&](const common_chat_templates_inputs & i) -> std::string {
+        try {
+            return common_chat_templates_apply(tmpls, i).prompt;
+        } catch (const std::exception &) {
+            return std::string();
+        }
+    };
+    auto future = [&](common_chat_templates_inputs i, const char * next_role, bool with_thinking) -> std::string {
+        common_chat_msg a;
+        a.role    = "assistant";
+        // a tool-calling answer has EMPTY content in practice, and the bytes right after the
+        // generation prompt decide the seam - measured: "probe-answer" there reported 0 where a
+        // real call parted at 1
+        a.content = std::string(next_role) == "tool" ? "" : "probe-answer";
+        if (with_thinking) {
+            a.reasoning_content = "probe-reasoning";
+        }
+        if (std::string(next_role) == "tool") {
+            common_chat_tool_call tc;
+            tc.name      = "probe_tool";
+            tc.arguments = "{}";
+            tc.id        = "probe-call-0";
+            a.tool_calls.push_back(tc);
+        }
+        i.messages.push_back(a);
+        common_chat_msg n;
+        n.role    = next_role;
+        n.content = "probe-next";
+        if (std::string(next_role) == "tool") {
+            n.tool_name    = "probe_tool";
+            n.tool_call_id = "probe-call-0";
+        }
+        i.messages.push_back(n);
+        return render(i);
+    };
+    auto char_div = [](const std::string & a, const std::string & b) -> size_t {
+        const size_t m = std::min(a.size(), b.size());
+        size_t c = 0;
+        while (c < m && a[c] == b[c]) ++c;
+        return c;
+    };
+    const std::string no_media;
+
+    // The seam is measured BEHIND the user text: both renders are cut right after X and compared
+    // from there. On a template that rewrites the user turn (Mistral moves the system prompt into
+    // it) the whole-string comparison would report the rewrite as the seam - 17 tokens instead of
+    // 1 - and the real seam would go unplaced. Behind X both tails begin with the same bytes, so
+    // the window construction holds exactly as it does for whole strings.
+    auto seam_behind = [&](const std::string & a, const std::string & b, std::map<size_t, llama_tokens> & memo) -> int64_t {
+        const size_t xa = a.rfind(X);
+        const size_t xb = b.find(X);
+        if (xa == std::string::npos || xb == std::string::npos) {
+            return -1;
+        }
+        // the tail of `a` re-keyed: memo positions are offsets into the cut string
+        return tail_divergence(vocab, a.substr(xa + X.size()), b.substr(xb + X.size()), window_chars, no_media, memo);
+    };
+
+    const std::string base_u = render(in);
+    if (!base_u.empty() && base_u.rfind(X) != std::string::npos) {
+        const size_t x_end = base_u.rfind(X) + X.size();
+        std::map<size_t, llama_tokens> memo;
+        const std::string nt = future(in, "user", false);
+        const std::string th = future(in, "user", true);
+        if (!nt.empty()) {
+            if (char_div(base_u, nt) < x_end) t.rewrites_history = true;
+            t.off_nothink = seam_behind(base_u, nt, memo);
+        }
+        if (!th.empty()) {
+            if (char_div(base_u, th) < x_end) t.rewrites_history = true;
+            t.off_think = seam_behind(base_u, th, memo);
+        }
+        t.ok = true;
+    }
+
+    // the tool future needs tools declared, which changes the system block - its own base
+    {
+        common_chat_templates_inputs it = in;
+        common_chat_tool tool;
+        tool.name        = "probe_tool";
+        tool.description = "probe";
+        tool.parameters  = "{\"type\":\"object\",\"properties\":{}}";
+        it.tools.push_back(tool);
+        const std::string base_t = render(it);
+        if (!base_t.empty() && base_t.rfind(X) != std::string::npos) {
+            const size_t x_end = base_t.rfind(X) + X.size();
+            std::map<size_t, llama_tokens> memo;
+            const std::string tn = future(it, "tool", false);
+            const std::string tt = future(it, "tool", true);
+            if (!tn.empty()) {
+                if (char_div(base_t, tn) < x_end) t.rewrites_history = true;
+                t.off_tool_nothink = seam_behind(base_t, tn, memo);
+            }
+            if (!tt.empty()) {
+                if (char_div(base_t, tt) < x_end) t.rewrites_history = true;
+                t.off_tool_think = seam_behind(base_t, tt, memo);
+            }
+        }
+    }
+
+    LOG_INF("[probe] template traits (enable_thinking=%d): rewrites history = %s, seam offsets think/nothink/tool(think)/tool(nothink) = %lld/%lld/%lld/%lld tokens before the end\n",
+            like.enable_thinking ? 1 : 0, t.rewrites_history ? "YES - the last user turn is a candidate" : "no",
+            (long long) t.off_think, (long long) t.off_nothink, (long long) t.off_tool_think, (long long) t.off_tool_nothink);
+
+    std::lock_guard<std::mutex> lk(mu);
+    cache[key] = t;
+    return t;
+}
+
+// [PROBE] where will the NEXT prompt of this conversation diverge from this one?
+//
+// Two sources, and they are handled differently:
+//
+//  - The SEAM: how this turn's answer will be rendered against the generation prompt it was
+//    produced from - with reasoning, without, followed by a tool result. A property of the template,
+//    measured once (template_traits_for) and then free.
+//
+//  - The DROP: a reasoning block that is in this prompt and will not be in the next one. Which one
+//    is structural, not a matter of rendering: the OLDEST block still carried. A harness that keeps
+//    only the most recent reasoning has exactly one, the newest; one that keeps the last k drops the
+//    oldest of them next; a tool loop under a template that strips reasoning once a user turn follows
+//    loses the first block of the loop. So the first assistant message carrying reasoning is looked
+//    up in the render, and the position just before its opening tag is the candidate. No render.
+//
+// `marks` carries the reasoning tags the chat format knows; the derivation is the fallback.
+// `media_marker`, when non-empty, refuses positions with media behind them (see tail_divergence).
+static divergence probe(const struct common_chat_templates * tmpls,
+                        const common_chat_templates_inputs & base,
+                        const llama_vocab * vocab,
+                        const std::string & base_render,
+                        size_t window_chars,
+                        const think_marks * marks = nullptr,
+                        const std::string & media_marker = std::string()) {
+    divergence d;
+
+    // the LAST assistant turn, not the first: a harness that keeps only the most recent reasoning
+    // has older turns without it, and reading those would report the wrong policy.
+    const think_marks tm = (marks && marks->known) ? *marks : derive_think_marks(tmpls);
+    for (auto it = base.messages.rbegin(); it != base.messages.rend(); ++it) {
+        if (it->role == "assistant") {
+            size_t b = 0, l = 0;
+            d.echo_known      = true;
+            d.echoes_thinking = message_has_thinking(*it, tm, b, l);
+            break;
+        }
+    }
+
+    const int64_t t0 = ggml_time_us();
+
+    bool tools_possible = !base.tools.empty();
+    for (const auto & m : base.messages) {
+        if (!m.tool_calls.empty() || m.role == "tool") {
+            tools_possible = true;
+            break;
+        }
+    }
+
+    // --- the seam: per template, measured once ------------------------------------------------
+    const template_traits tr = template_traits_for(tmpls, vocab, base, window_chars);
+    if (tr.ok) {
+        d.user_think       = tr.off_think;
+        d.user_nothink     = tr.off_nothink;
+        d.tool             = tools_possible ? (d.echoes_thinking ? tr.off_tool_think : tr.off_tool_nothink) : -1;
+        d.rewrites_history = tr.rewrites_history;
+    }
+
+    // a message's text as it will appear in the render: trimmed, capped, empty if there is none
+    auto text_of = [](const common_chat_msg & m) -> std::string {
+        std::string t = m.content;
+        const size_t f = t.find_first_not_of(" \t\r\n");
+        if (f == std::string::npos) {
+            return std::string();
+        }
+        t = t.substr(f);
+        const size_t e = t.find_last_not_of(" \t\r\n");
+        t = t.substr(0, e == std::string::npos ? t.size() : e + 1);
+        return t.size() > 192 ? t.substr(0, 192) : t;
+    };
+
+    // --- the rewrite: structural ------------------------------------------------------------
+    // The template renders the last user turn differently from any other, so the previous prompt's
+    // last user turn is re-rendered now. Everything before the end of the message preceding it is
+    // untouched; the divergence lies in the turn header or its text. Candidate range: from one token
+    // before the end of that previous message up to the start of the last user text.
+    if (tr.ok && tr.rewrites_history) {
+        int64_t iu = -1, ip = -1;
+        for (int64_t i = (int64_t) base.messages.size() - 1; i >= 0; --i) {
+            if (base.messages[i].role == "user") { iu = i; break; }
+        }
+        for (int64_t i = iu - 1; i >= 0; --i) {
+            const auto & r = base.messages[i].role;
+            if (r != "system" && r != "developer") { ip = i; break; }
+        }
+        if (iu >= 0) {
+            const std::string tu = text_of(base.messages[iu]);
+            const size_t pu = tu.empty() ? std::string::npos : base_render.rfind(tu);
+            // the end of the message before the last user turn - or the very start of the render
+            // when there is none but the system prompt: on the first turn the whole turn header
+            // is what gets re-rendered (Mistral puts the system prompt right there)
+            size_t end_prev = std::string::npos;
+            if (pu != std::string::npos) {
+                if (ip >= 0) {
+                    const std::string tp = text_of(base.messages[ip]);
+                    const size_t pp = tp.empty() ? std::string::npos : base_render.rfind(tp, pu);
+                    if (pp != std::string::npos) {
+                        end_prev = pp + tp.size();
+                    }
+                } else {
+                    end_prev = 0;
+                }
+            }
+            if (end_prev != std::string::npos) {
+                if (media_marker.empty() || base_render.find(media_marker, end_prev) == std::string::npos) {
+                    const int64_t to_prev = tokens_to_end(vocab, base_render, end_prev, window_chars);
+                    const int64_t to_user = tokens_to_end(vocab, base_render, pu, window_chars);
+                    if (to_prev >= 0 && to_user >= 0) {
+                        // one token before the end of the previous message; from the render start
+                        // that is position 1, i.e. all tokens but one before the end
+                        d.rewrite    = end_prev == 0 ? to_prev - 1 : to_prev + 1;
+                        d.rewrite_hi = to_user;
+                    }
+                }
+            }
+        }
+    }
+
+    // --- the drop: structural, no render --------------------------------------------------------
+    {
+        // the OLDEST assistant message whose reasoning the template actually RENDERED. A harness may
+        // carry reasoning on every message while the template shows only the last one's (or none
+        // before the last user turn) - what can be dropped from the next prompt is what is in this
+        // one, so a carrier whose text is not in the render does not count.
+        bool    any_carrier = false;
+        size_t  pos         = std::string::npos;
+        for (const auto & m : base.messages) {
+            if (m.role != "assistant") {
+                continue;
+            }
+            size_t b = 0, l = 0;
+            if (!message_has_thinking(m, tm, b, l)) {
+                continue;
+            }
+            std::string text = !m.reasoning_content.empty()
+                             ? m.reasoning_content
+                             : m.content.substr(b + tm.open.size(), l > tm.open.size() ? l - tm.open.size() : 0);
+            const size_t f = text.find_first_not_of(" \t\r\n");
+            if (f == std::string::npos) {
+                continue;   // whitespace only: renders as no reasoning
+            }
+            text = text.substr(f);
+            const size_t e = text.find_last_not_of(" \t\r\n");
+            text = text.substr(0, e == std::string::npos ? text.size() : e + 1);
+            any_carrier = true;
+            const std::string needle = text.substr(0, 192);
+            pos = base_render.find(needle);
+            if (pos == std::string::npos && needle.size() > 48) {
+                pos = base_render.find(needle.substr(0, 48));   // a template may re-wrap long lines
+            }
+            if (pos != std::string::npos) {
+                break;
+            }
+        }
+
+        if (pos == std::string::npos) {
+            // nothing rendered carries reasoning: this future coincides with user_think. (a carrier
+            // exists but the template dropped it: same thing, there is nothing left to drop)
+            d.user_drop = -2;
+            if (any_carrier) {
+                LOG_DBG("[probe] %s", "reasoning is carried but not rendered - nothing to drop\n");
+            }
+        } else {
+            // the opening tag right before the text, if the template has one
+            size_t tag = pos;
+            if (!tm.open.empty()) {
+                const size_t o = base_render.rfind(tm.open, pos);
+                if (o != std::string::npos && pos - o <= tm.open.size() + 16) {
+                    tag = o;
+                }
+            }
+            if (!media_marker.empty() && base_render.find(media_marker, tag) != std::string::npos) {
+                d.user_drop = -1;   // media behind the position: not countable here
+            } else {
+                const int64_t to_tag = tokens_to_end(vocab, base_render, tag, window_chars);
+                const int64_t to_txt = tokens_to_end(vocab, base_render, pos, window_chars);
+                if (to_tag >= 0 && to_txt >= 0) {
+                    // one token before the tag, like a hint: the token spanning the seam is not
+                    // determined by the text before it alone. The divergence itself lies before
+                    // the first reasoning token.
+                    d.user_drop    = to_tag + 1;
+                    d.user_drop_hi = to_txt;
+                }
+            }
+        }
+    }
+
+    // under a template that re-renders the last user turn, the user futures' seams lie BEHIND the
+    // rewrite and can never be reached - the rewrite is the divergence. Only the tool seam stays:
+    // a tool result does not end the user turn, so nothing moves before it.
+    if (d.rewrites_history && d.rewrite > 0) {
+        d.user_think   = 0;
+        d.user_nothink = 0;
+    }
+
+    d.user = d.echoes_thinking ? d.user_think : d.user_nothink;
+    d.us   = ggml_time_us() - t0;
+
+    return d;
+}
+
+static json to_json(const divergence & d) {
+    // offsets from the end, in tokens. The consumer turns them into positions with its own count.
+    return json{
+        {"user",         d.user},
+        {"tool",         d.tool},
+        {"user_think",   d.user_think},
+        {"user_nothink", d.user_nothink},
+        {"user_drop",    d.user_drop == -2 ? (int64_t) -1 : d.user_drop},
+        {"user_drop_hi", d.user_drop_hi},
+        {"drop_moot",    d.user_drop == -2},
+        {"rewrite",      d.rewrite},
+        {"rewrite_hi",   d.rewrite_hi},
+        {"rewrites",     d.rewrites_history},
+        {"echo",         d.echoes_thinking},
+        {"echo_known",   d.echo_known},
+        // complete = every future that can differ was rendered or resolved. A moot drop future (-2)
+        // is not a gap, it coincides with user_think; only a failure (-1) leaves a hole.
+        {"complete",     d.echo_known && d.user_drop != -1},
+        {"us",           d.us},
+    };
+}
+
+static json to_json(const result & res) {
+    json hs = json::array();
+    for (const auto & h : res.hints) {
+        hs.push_back(json{
+            {"kind",    hint_kind_name(h.kind)},
+            {"anchor",  hint_anchor_name(h.anchor)},
+            {"back",    h.back},
+            {"off",     h.off},
+            {"pending", h.pending_generation},
+            {"live",    h.live},
+            {"to_end",  h.tokens_to_end},
+            {"why",     h.why_unresolved},
+        });
+    }
+    return json{
+        {"activated", res.activated},
+        {"markers",   res.n_markers},
+        {"rejected",  res.n_rejected},
+        {"reject",    res.reject},
+        {"hints",     hs},
+    };
+}
+
+} // namespace server_analyzer
