+{% endif -%}
diff --git a/tools/server/tests-snap/templates/mistral-like.jinja b/tools/server/tests-snap/templates/mistral-like.jinja
new file mode 100644
index 0000000..3110872
--- /dev/null
+++ b/tools/server/tests-snap/templates/mistral-like.jinja
@@ -0,0 +1,19 @@
+{#- Mistral-style: the system prompt travels with the LAST user message, so every turn rewrites the
+    previous user message. A template that rewrites history behind the seam - the case the probe
+    must render live instead of trusting fixed seam offsets. Reasoning in <think> tags. -#}
+{%- set ns = namespace(last_user=-1, sys='') -%}
+{%- for m in messages -%}
+{%- if m.role == 'user' -%}{%- set ns.last_user = loop.index0 -%}{%- endif -%}
+{%- if m.role == 'system' -%}{%- set ns.sys = m.content -%}{%- endif -%}
+{%- endfor -%}
+{%- for m in messages -%}
+{%- if m.role == 'user' -%}
+[INST] {% if loop.index0 == ns.last_user and ns.sys %}{{ ns.sys }}
+
+{% endif %}{{ m.content }} [/INST]
+{%- elif m.role == 'assistant' -%}
+{% if m.reasoning_content %}<think>{{ m.reasoning_content }}</think>{% endif %}{{ m.content }}{% if m.tool_calls %}[TOOL_CALLS] {{ m.tool_calls | tojson }}{% endif %}</s>
+{%- elif m.role == 'tool' -%}
+[TOOL_RESULTS] {{ m.content }} [/TOOL_RESULTS]
+{%- endif -%}
+{%- endfor -%}
