+        if (std::filesystem::exists(path)) {
+            snapshot_touch(snapshot_name(snapshot_hash(toks, n_tokens), n_tokens), path);
+            return false;
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        common_prompt_checkpoint ck;
+        ck.update_pos(n_tokens, 0, n_tokens - 1);
+        ck.update_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        if (ctx_dft) {
+            ck.update_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        }
+        if (slot.spec) {
+            common_speculative_get_state(slot.spec, slot.id, ck.data_spec);
+        }
+
+        if (!snapshot_make_room(slot, ck.size())) {
+            return false;
+        }
+
+        std::ofstream f(path + ".tmp", std::ios::binary);
+        if (!f) {
+            SLT_WRN(slot, "[snapshot] cannot write %s\n", path.c_str());
+            return false;
+        }
+        f.write("LSNP", 4);
+        wr(f, (uint32_t) 3);
+        wr(f, (uint64_t) llama_model_size(model_tgt));
+        wr(f, (uint64_t) llama_model_n_params(model_tgt));
+        wr(f, (uint32_t) llama_n_ubatch(ctx_tgt));
+        wr(f, (uint32_t) llama_n_ctx_seq(ctx_tgt));
+        wr(f, (uint32_t) n_tokens);
+        f.write((const char *) toks.data(), (size_t) n_tokens * sizeof(llama_token));
+        wr_blob(f, ck.data_tgt);
+        wr_blob(f, ck.data_dft);
+        wr_blob(f, ck.data_spec);
+        f.close();
+
+        std::error_code ec;
+        std::filesystem::rename(path + ".tmp", path, ec);
+
+        snapshot_files[snapshot_name(snapshot_hash(toks, n_tokens), n_tokens)] = {ck.size(), snapshot_now()};
+        snapshot_lengths.insert(n_tokens);
+        snapshot_bytes += ck.size();
+
+        SLT_INF(slot, "[snapshot] saved %d tokens, %.1f MB in %.0f ms -> %s\n",
+                n_tokens, ck.size() / 1e6, (ggml_time_us() - t0) / 1000.0, path.c_str());
+        return true;
+    }
+
+    // a slot that served a growing session is about to lose its content: keep it on disk at every context
+    // checkpoint position, rolling back. the roll-back is the server's own checkpoint-restore trick: load
+    // the recurrent state of the checkpoint (PARTIAL_ONLY), then seq_rm() everything behind it; the
+    // attention cells up to there are still in place, so the sequence is now a complete state at that
+    // position. descending, since every step truncates. the newest checkpoint sits at L-4 of the last
+    // prompt - exactly where a returning turn diverges when the template strips the thinking from the
+    // history. the decoded length itself is not kept: with stripped thinking it can never match.
+    // the slot is unusable afterwards - callers clear it.
+    void snapshot_dump_slot(server_slot & slot) {
+        SLT_DBG(slot, "[snapshot] dump check: n = %zu, n_grow = %d (need %d), pins = %zu\n",
+                slot.prompt.tokens.size(), slot.n_grow, snapshot_evict_turns, slot.ckpt_pinned.size());
+        // [ANALYZER] a pinned position is a declaration, not a guess: the harness said it will come
+        // back here. It therefore does not have to earn its way past the growing-turns gate the way
+        // the three guessed points do - that gate exists to keep us from writing gigabytes for
+        // one-off requests, and a pin is the opposite of a one-off.
+        const bool have_pins = !slot.ckpt_pinned.empty() || slot.hint_gen_ckpt;
+
+        if (snapshot_path.empty()) {
+            return;
+        }
+        if (!have_pins && (snapshot_evict_turns <= 0 || slot.n_grow < snapshot_evict_turns)) {
+            return;
+        }
+        const server_tokens & toks = slot.prompt.tokens;
+
+        // three states matter, one per way the next prompt can be rendered:
+        //   bit 0: end of generation   - thinking preserved -> the follow-up is a pure append
+        //   bit 1: newest checkpoint   - thinking dropped   -> diverges at the last turn boundary
+        //   bit 2: 2nd newest          - only last thinking -> diverges one turn boundary earlier
+        // a token window is meaningless here: what counts is which boundary, not how far back it is.
+        std::vector<const common_prompt_checkpoint *> cps;
+        for (const auto & ck : slot.prompt.checkpoints) {
+            if (ck.n_tokens >= snapshot_min_tokens && (size_t) ck.n_tokens < toks.size()) {
+                cps.push_back(&ck);
+            }
+        }
+        std::sort(cps.begin(), cps.end(), [](const auto * a, const auto * b) { return a->n_tokens > b->n_tokens; });
+
+        // [SNAPSHOT] narrow the mask to what this session actually used. a client renders the
+        // history the same way every turn, so a state no turn ever resumed from will not be needed
+        // after eviction either - and each one costs ~41 KB per token on the SSD. only ever narrows,
+        // never widens: bits outside snapshot-evict-points stay off. with no informative turn yet
+        // (a single-turn slot, or one that only ever hit disk snapshots) nothing is narrowed and all
+        // configured points are written, which is the conservative case.
+        // [PROBE] which state this session will actually come back to is not a guess any more: the
+        // probe computed it, from the template and this harness's own echo policy, on every request.
+        //   probe ran, no positions -> the next prompt is a pure append -> the end of generation
+        //   probe ran, positions    -> it diverges there              -> the checkpoint at each
+        //   no probe                -> fall back to the end of generation, the one state that is
+        //                              always correct for an append and costs no roll-back
+        int32_t points = 0;
+        if (snapshot_evict_turns > 0 && slot.n_grow >= snapshot_evict_turns) {
+            points = (!slot.probe_done || slot.probe_at.empty()) ? 1 : 2;
+        }
+        // [ANALYZER] `ckpt at=agent`: the harness said it resumes at the end of this answer. That
+        // is a declaration, and it beats what the probe guessed.
+        if (slot.hint_gen_ckpt) {
+            points |= 1;
+        }
+
+        // descending, because every roll-back truncates. the live state (no roll-back) comes first.
+        struct step { int32_t n; const common_prompt_checkpoint * ck; const char * why; bool trunc = false; };
+        std::vector<step> steps;
+        if (points & 2) {
+            bool any = false;
+            for (const auto & c : slot.probe_at) {
+                // only the future this session was SEEN to take, once that is established
+                if (slot.probe_kind >= 0 && c.kind != slot.probe_kind) {
+                    continue;
+                }
+                if (!ckpt_required()) {
+                    // no checkpoint exists or is needed: truncate to the position and save there.
+                    // Bounded by what the slot actually holds - a request cancelled mid-prefill
+                    // leaves a candidate for a prompt the slot never reached (measured: candidate
+                    // 21878 on 2788 tokens, "truncation failed", nothing kept).
+                    if (c.n >= snapshot_min_tokens && c.n < (int32_t) toks.size()) {
+                        steps.push_back({c.n, nullptr, "probed divergence", true});
+                        any = true;
+                    }
+                    continue;
+                }
+                const common_prompt_checkpoint * exact = nullptr;
+                const common_prompt_checkpoint * below = nullptr;
+                const int32_t hi = std::max(c.n, c.hi);
+                for (const auto * cp : cps) {
+                    if ((int32_t) cp->n_tokens >= c.n && (int32_t) cp->n_tokens <= hi) {
+                        if (exact == nullptr || cp->n_tokens > exact->n_tokens) {
+                            exact = cp;   // the newest inside the range
+                        }
+                    } else if ((int32_t) cp->n_tokens < c.n && (below == nullptr || cp->n_tokens > below->n_tokens)) {
+                        below = cp;
+                    }
+                }
+                if (exact) {
+                    // a stateless entry is a position only: reach it by truncating
+                    steps.push_back({(int32_t) exact->n_tokens, exact->data_tgt.empty() ? nullptr : exact,
+                                     "probed divergence", exact->data_tgt.empty()});
+                    any = true;
+                } else if (below) {
+                    // [SNAPSHOT] the computed position has no checkpoint - a request cancelled before
+                    // the stop was passed, a budget refusal, the cap. The nearest one below still
+                    // covers the divergence at the price of the stretch between them, which is far
+                    // better than nothing: measured 2026-09-16, a 13-turn session whose last request
+                    // was cancelled at exactly its stop left NOTHING on disk and the follow-ups
+                    // re-prefilled 35k and 40k tokens.
+                    SLT_WRN(slot, "[snapshot] no checkpoint at the probed divergence %d - keeping the nearest below at %d instead\n",
+                            c.n, (int32_t) below->n_tokens);
+                    steps.push_back({(int32_t) below->n_tokens, below->data_tgt.empty() ? nullptr : below,
+                                     "nearest checkpoint below the probed divergence", below->data_tgt.empty()});
+                    any = true;
+                }
+            }
+            if (!any) {
+                SLT_WRN(slot, "%s", "[snapshot] no checkpoint at or below any probed divergence - keeping the end of generation instead\n");
+                points |= 1;
+            }
+        }
+        if (points & 1) {
+            const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+            const int32_t   n_full  = std::min<int32_t>(pos_max + 1, (int32_t) toks.size());
+            if (n_full >= snapshot_min_tokens) {
+                steps.push_back({n_full, nullptr, "end of generation"});
+            }
+        }
+
+        // [ANALYZER] a checkpoint the harness asked for is a position it declared it will come back
+        // to. That is better information than any of the three rules above, so it goes to disk on the
+        // way out regardless of the point mask and regardless of what the session was seen to use -
+        // the mask narrows guesses, and this is not a guess. Volatile becomes persistent exactly
+        // where the harness said it matters.
+        for (const int32_t pin : slot.ckpt_pinned) {
+            if (pin < snapshot_min_tokens || (size_t) pin >= toks.size()) {
+                continue;
+            }
+            bool already = false;
+            for (const auto & st : steps) {
+                if (st.n == pin) {
+                    already = true;
+                    break;
+                }
+            }
+            if (already) {
+                continue;
+            }
+            for (const auto * cp : cps) {
+                if ((int32_t) cp->n_tokens == pin) {
+                    steps.push_back({pin, cp, "pinned by a hint"});
+                    break;
+                }
+            }
+        }
+
+        if (steps.empty()) {
+            SLT_WRN(slot, "[snapshot] slot leaves after %d growing turns with NOTHING written (%zu checkpoints, %zu tokens)\n",
+                    slot.n_grow, cps.size(), toks.size());
+            return;
+        }
+
+        // descending: every roll-back truncates, so a later step must not sit above an earlier one
+        std::sort(steps.begin(), steps.end(), [](const step & a, const step & b) { return a.n > b.n; });
+
+        const int64_t t0 = ggml_time_us();
+        SLT_INF(slot, "[snapshot] slot leaves after %d growing turns: keeping %zu state(s) (%s, %zu pin(s), %zu checkpoints)\n",
+                slot.n_grow, steps.size(),
+                !slot.probe_done ? "no probe" : slot.probe_at.empty() ? "probe: pure append" : "probe: diverges",
+                slot.ckpt_pinned.size(), cps.size());
+
+        int n_saved = 0;
+        for (const auto & st : steps) {
+            if (st.trunc) {
+                // partial removal is supported here, so the position is reached by truncating
+                slot.mem.seq_rm(slot.id, st.n, -1);
+                if (llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id) != st.n - 1) {
+                    SLT_WRN(slot, "[snapshot] truncation to %d failed, stopping\n", st.n);
+                    break;
+                }
+            } else if (st.ck) {
+                st.ck->load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                if (ctx_dft && !st.ck->data_dft.empty()) {
+                    st.ck->load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                }
+                if (slot.spec && !st.ck->data_spec.empty()) {
+                    common_speculative_set_state(slot.spec, slot.id, st.ck->data_spec);
+                }
+                slot.mem.seq_rm(slot.id, st.n, -1);
+                if (llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id) != st.n - 1) {
+                    SLT_WRN(slot, "[snapshot] roll-back to %d failed, stopping\n", st.n);
+                    break;
+                }
+            }
+            SLT_DBG(slot, "[snapshot] keeping %s at %d\n", st.why, st.n);
+            if (snapshot_save(slot, toks, st.n)) {
+                n_saved++;
+            }
+        }
+        SLT_INF(slot, "[snapshot] kept %d states in %.0f ms\n", n_saved, (ggml_time_us() - t0) / 1000.0);
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // [ANALYZER] in-band hints: from a resolved token position to something that actually happens
+    // ---------------------------------------------------------------------------------------------
+    //
+    // A hint names a position in THIS prompt. Whether it can be honoured depends on where the prefill
+    // currently stands:
+    //
+    //   H > n_past   the prefill will pass it anyway -> stop the batch there, act, carry on. free.
+    //   H = n_past   the state already sits there    -> act now. free.
+    //   H < n_past   already passed -> only reachable by rolling back to a checkpoint at or before H
+    //                and prefilling forward again. bounded by --snap-hint-max-reprefill, handled in
+    //                snap_hint_floor() before the checkpoint search, not here.
+    //
+    // Cheapness first: a snapshot that is already on disk, and a checkpoint that is already in the
+    // slot, are satisfied without any of the above. That ordering is what lets a harness carry its
+    // hints along in the history for free instead of having to remove them again.
+
+    // [SNAPSHOT] Does reaching an earlier position need a checkpoint on this model?
+    //
+    // On a plain global-attention model it does not: the memory supports partial removal, so
+    // seq_rm truncates the sequence to any position exactly and the state that remains IS the
+    // state at that position. Checkpoints are never created there, and code that insists on
+    // finding one would silently do nothing at all - which is what the eviction dump and the hint
+    // roll-back did until 2026-09-15. Trivial on such a model, which is precisely why it must not
+    // be the case that falls through the cracks (operator).
+    //
+    // It is needed when the memory can only be cleared wholesale (FULL), when a recurrent state
+    // has to be carried (RS), or when a sliding window has already dropped what lies behind.
+    bool ckpt_required() const {
+        return ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+               ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS   ||
+               n_swa > 0;
+    }
+
+    // the re-prefill budget for a hint, in tokens. -1 means one ubatch - the smallest unit the
+    // prefill runs in anyway, so a hint that fits in it costs no extra round.
+    int32_t snap_hint_budget() const {
+        const int32_t v = params_base.snap_hint_max_reprefill;
+        return v < 0 ? (int32_t) llama_n_ubatch(ctx_tgt) : v;
+    }
+
+    // Whether a checkpoint belongs at this position because the harness asked for one. This reads
+    // ckpt_pinned and NOT the stop list: a stop is consumed the moment the prefill reaches it, which
+    // happens earlier in the same iteration than the checkpoint decision. The pin list also outlives
+    // the request, which is what makes the position survive into the eviction dump.
+    static bool snap_stop_wants_ckpt(const server_slot & slot, int32_t n) {
+        return std::find(slot.ckpt_pinned.begin(), slot.ckpt_pinned.end(), n) != slot.ckpt_pinned.end()
+            || std::find(slot.ckpt_probe .begin(), slot.ckpt_probe .end(), n) != slot.ckpt_probe .end();
+    }
+
+    // Is a hint already satisfied without doing anything? Checked before any roll-back is considered,
+    // so a harness that carries its hints along in the history never pays for a detour to a state
+    // that is already there.
+    bool snap_hint_satisfied(const server_slot & slot, const snap_hint & h, int32_t H, const llama_tokens & toks) {
+        if (h.kind == 1) {
+            for (const auto & ck : slot.prompt.checkpoints) {
+                if (ck.n_tokens == H) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        if (snapshot_path.empty()) {
+            return true;   // nothing we could do, and nothing to roll back for
+        }
+        return std::filesystem::exists(snapshot_path + "/" + snapshot_name(snapshot_hash(toks, H), H));
+    }
+
+    // [ANALYZER] A hint whose position the prefill has already passed is only reachable by going
+    // back. The way back is the server's own checkpoint-restore trick: load the recurrent state of a
+    // checkpoint at or before the position (PARTIAL_ONLY), lower n_past to it, and let the normal
+    // path recompute forward - seq_rm past n_past and the prefill loop do the rest, so the hint then
+    // falls into the ordinary "the prefill will pass it" case.
+    //
+    // The price is the re-prefill, and --snap-hint-max-reprefill bounds it. A hint that costs more is
+    // dropped with the number in the journal, so the harness can see it hinted too late rather than
+    // silently paying for it. The same bound covers both kinds: a checkpoint needs the state at that
+    // position exactly as much as a snapshot does, it just keeps it in RAM.
+    int32_t snap_hint_rollback(server_slot & slot, int32_t n_past) {
+        if (slot.task->snap_hints.empty() || n_past <= 0) {
+            return n_past;
+        }
+
+        const int32_t n_prompt = (int32_t) slot.task->n_tokens();
+        const llama_tokens toks = snapshot_key_tokens(slot.task->tokens);
+
+        int32_t floor = -1;
+        for (const auto & h : slot.task->snap_hints) {
+            if (h.pending || !h.live || h.n_tokens <= 0 || h.n_tokens >= n_prompt) {
+                continue;   // a historic hint never buys a position back
+            }
+            const int32_t H = snapshot_align_media(slot.task->tokens, h.n_tokens);
+            if (H >= n_past || snap_hint_satisfied(slot, h, H, toks)) {
+                continue;
+            }
+            if (floor < 0 || H < floor) {
+                floor = H;
+            }
+        }
+        if (floor < 0) {
+            return n_past;
+        }
+
+        // On a model with partial removal there is no checkpoint to look for and none is needed:
+        // the position is reached by truncating the sequence to it. The budget still applies -
+        // the tokens between it and n_past are re-prefilled either way.
+        if (!ckpt_required()) {
+            const int32_t budget = snap_hint_budget();
+            const int32_t cost   = n_past - floor;
+            if (cost > budget) {
+                SLT_WRN(slot, "[hint] position %d would cost %d tokens of re-prefill (budget %d): dropped\n",
+                        floor, cost, budget);
+                return n_past;
+            }
+            slot.mem.seq_rm(slot.id, floor, -1);
+            if (llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id) != floor - 1) {
+                SLT_WRN(slot, "[hint] truncation to %d failed: dropped\n", floor);
+                return n_past;
+            }
+            SLT_INF(slot, "[hint] truncated %d -> %d for a hint there (%d tokens of re-prefill, budget %d)\n",
+                    n_past, floor, cost, budget);
+            slot.stats.tel_hint_reprefill = cost;
+            return floor;
+        }
+
+        const common_prompt_checkpoint * best = nullptr;
+        for (const auto & ck : slot.prompt.checkpoints) {
+            if (ck.n_tokens <= floor && (best == nullptr || ck.n_tokens > best->n_tokens)) {
+                best = &ck;
+            }
+        }
+        if (best == nullptr) {
+            SLT_WRN(slot, "[hint] position %d is behind the prefill at %d and no checkpoint reaches it: dropped\n",
+                    floor, n_past);
+            return n_past;
+        }
+
+        const int32_t budget = snap_hint_budget();
+        const int32_t cost   = n_past - (int32_t) best->n_tokens;
+        if (cost > budget) {
+            SLT_WRN(slot, "[hint] position %d would cost %d tokens of re-prefill (checkpoint at %" PRId64 ", budget %d): dropped\n",
+                    floor, cost, best->n_tokens, budget);
+            return n_past;
+        }
+
+        best->load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+        best->load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+        common_speculative_set_state(spec.get(), slot.id, best->data_spec);
+
+        SLT_INF(slot, "[hint] rolled back %d -> %" PRId64 " for a hint at %d (%d tokens of re-prefill, budget %d)\n",
+                n_past, best->n_tokens, floor, cost, budget);
+        slot.stats.tel_hint_reprefill = cost;
+
+        return (int32_t) best->n_tokens;
+    }
+
+    // fold the automatic snapshot position and this request's hints into one ascending stop list
+    void snap_hints_plan(server_slot & slot, int32_t n_past, int32_t auto_snap_n) {
+        slot.snap_stops.clear();
+        slot.snap_hint_at_gen = false;
+        // [ANALYZER] pins are this request's declarations, rebuilt every time. The previous request's
+        // pins have done their work by now - the picker has already resumed on them - and a marker
+        // the harness still carries re-declares its position below, as a soft pin once it is history.
+        slot.ckpt_pinned.clear();
+        slot.ckpt_pinned_soft.clear();
+        slot.hint_gen_ckpt = false;
+
+        auto add_stop = [&](int32_t n, bool snap, bool ckpt, bool hinted) {
+            for (auto & st : slot.snap_stops) {
+                if (st.n == n) {
+                    st.snap   = st.snap   || snap;
+                    st.ckpt   = st.ckpt   || ckpt;
+                    st.hinted = st.hinted || hinted;
+                    return;
+                }
+            }
+            slot.snap_stops.push_back({n, snap, ckpt, hinted});
+        };
+
+        if (auto_snap_n > 0) {
+            add_stop(auto_snap_n, true, false, false);
+        }
+
+        // [PROBE] a computed divergence point is where the NEXT prompt of this conversation will
+        // need a checkpoint. Only ahead of the prefill: a point already behind it would cost a
+        // roll-back, and unlike a hint nobody asked for this one - it is worth what it is free.
+        slot.ckpt_probe.clear();
+
+        // [PROBE] the observed divergence, when there is one. It is placed alongside whatever the
+        // probe computed, not instead of it: the probe may be right about one future and blind to
+        // another, and this one is paid for by a measurement rather than a render.
+        if (slot.div_offset > 0) {
+            const int32_t p = (int32_t) slot.task->n_tokens() - slot.div_offset;
+            if (p > n_past && p < (int32_t) slot.task->n_tokens()) {
+                slot.ckpt_probe.push_back(p);
+                slot.stats.tel_probe.push_back(p);
+                add_stop(p, false, true, false);
+                SLT_DBG(slot, "[probe] checkpoint at the observed divergence: %d (%d before the prompt end)\n",
+                        p, slot.div_offset);
+            }
+        }
+
+        if (slot.task->probe_done) {
+            slot.probe_done     = true;
+            slot.probe_at       = slot.task->ckpt_probe;
+            slot.probe_complete = slot.task->probe_complete;
+        }
+        slot.stats.tel_probe_done = slot.task->probe_done;
+        slot.stats.tel_probe_kind = slot.probe_kind;
+        slot.stats.tel_probe_miss = slot.probe_miss;
+        slot.stats.tel_probe_append = slot.probe_append;
+        slot.stats.tel_div_offset = slot.div_offset;
+        slot.stats.tel_probe.clear();
+        slot.stats.tel_probe_all.clear();
+        slot.stats.tel_probe_hi.clear();
+        slot.stats.tel_probe_kinds.clear();
+        for (const auto & c : slot.task->ckpt_probe) {
+            slot.stats.tel_probe_all.push_back(c.n);
+            slot.stats.tel_probe_hi.push_back(std::max(c.n, c.hi));
+            slot.stats.tel_probe_kinds.push_back(c.kind);
+        }
+        // [PROBE] two passes. The first honours the future this session was seen to take; the
+        // second runs only if that left NOTHING placed. A commit exists to stop spending
+        // checkpoints on futures that will not happen - if it spends none at all it has saved
+        // nothing and costs the next turn a roll-back. Measured on a harness that switches policy
+        // mid-conversation: the commit landed on the transition itself, the single candidate of the
+        // following turn carried the other kind and was dropped, and the turn after it resumed from
+        // an unrelated checkpoint three tokens short of its divergence.
+        // [PROBE] which candidate kinds a committed future needs TODAY. The kinds name what the
+        // next prompt contains, and for "dropped the previous reasoning" (2) the position that the
+        // turn after next will need is where THIS turn's answer renders without its reasoning -
+        // which is this turn's kind-1 candidate. It only shows up as a kind-2 candidate one turn
+        // later, behind the prefill. Filtering strictly by the committed kind therefore dropped the
+        // very checkpoint the session was seen to use, and only the second pass below rescued it.
+        auto kind_wanted = [&](int32_t k) {
+            if (k == 4) {
+                return true;   // a template rewrite is not a harness policy: it happens every turn
+            }
+            if (slot.probe_kind < 0 || k == slot.probe_kind) {
+                return true;
+            }
+            return slot.probe_kind == 2 && k == 1;
+        };
+        // a committed drop (2) has a position in this prompt; a template rewrite (4) that lies
+        // behind it can never be the next prompt's divergence - the drop comes first every turn
+        int32_t drop_at = -1;
+        if (slot.probe_kind == 2) {
+            for (const auto & c : slot.task->ckpt_probe) {
+                if (c.kind == 2) {
+                    drop_at = c.n;
+                }
+            }
+        }
+        auto place_probe = [&](bool honour_kind) {
+            for (const auto & c : slot.task->ckpt_probe) {
+                if (slot.probe_miss >= 2) {
+                    break;   // this harness is not predictable from the template; stop guessing
+                }
+                if (honour_kind && !kind_wanted(c.kind)) {
+                    continue;   // the future is known; the others cost and pay nothing
+                }
+                if (honour_kind && c.kind == 4 && drop_at >= 0 && c.n > drop_at) {
+                    continue;   // unreachable: the session drops reasoning before this point every turn
+                }
+                // The append rule below must NOT gate this: an append-only session is exactly the
+                // one whose far-back position has to outlive the loop, and keeping an existing
+                // checkpoint spends nothing new - it only decides which one the cap takes first.
+                // Measured with the gate in front: cap 8, nine appending iterations, the position
+                // was evicted at the seventh and the user turn went to a fresh slot.
+                if (c.n < n_past) {
+                    // [PROBE] behind the prefill: not placeable now, but if an earlier turn already
+                    // created a checkpoint at exactly this position, that checkpoint is where the
+                    // next prompt will roll back to. Listing it here keeps it pinned against the cap,
+                    // ranked 1 by the budget and found by the eviction dump. Without this a tool loop
+                    // under a last-query template (reasoning kept inside the loop, stripped once a
+                    // user turn follows) computed the same far-back position on every iteration,
+                    // never protected it, and the cap evicted it after ctx-checkpoints iterations -
+                    // the user turn then went to a fresh slot with a full prefill (measured: cap 3
+                    // -> full, cap 12 -> 0 tokens recomputed).
+                    // any checkpoint inside the candidate's range serves - for the drop future that
+                    // is everything from one token before the tag up to the reasoning text
+                    for (const auto & ck : slot.prompt.checkpoints) {
+                        if ((int32_t) ck.n_tokens >= c.n && (int32_t) ck.n_tokens <= c.hi) {
+                            slot.ckpt_probe.push_back((int32_t) ck.n_tokens);
+                            SLT_DBG(slot, "[probe] keeping the checkpoint at %" PRId64 ", kind %d: computed divergence [%d, %d] behind the prefill (%d)\n",
+                                    ck.n_tokens, c.kind, c.n, c.hi, n_past);
+                        }
+                    }
+                    continue;
+                }
+                if (slot.probe_append >= 2) {
+                    break;   // this one only appends; a candidate would be spent and never used
+                }
+                // >= and not >: a position the prefill starts AT still needs its checkpoint. Skipping
+                // it left the next turn to fall back on the end anchor of the turn before (measured: 193
+                // instead of 197, four tokens recomputed every turn). The stop is only there to split the
+                // batch, so it is added only when the batch would otherwise run past the position - at
+                // n_past the batch already begins there, and a stop would split off an empty one.
+                if (c.n >= n_past && c.n < (int32_t) slot.task->n_tokens()) {
+                    slot.ckpt_probe.push_back(c.n);
+                    slot.stats.tel_probe.push_back(c.n);   // what was PLACED, not what was considered
+                    if (c.n > n_past) {
+                        add_stop(c.n, false, true, false);
+                    }
+                    SLT_DBG(slot, "[probe] checkpoint planned at %d, kind %d (prefill stands at %d)%s\n",
+                            c.n, c.kind, n_past, honour_kind ? "" : " - the committed future yielded nothing");
+                }
+            }
+        };
+        place_probe(true);
+        if (slot.ckpt_probe.empty()) {
+            place_probe(false);
+        }
+
+        if (!slot.task->snap_hints.empty()) {
+            const int32_t n_prompt = (int32_t) slot.task->n_tokens();
+            const llama_tokens toks = snapshot_key_tokens(slot.task->tokens);
+
+            for (const auto & h : slot.task->snap_hints) {
+                if (h.pending) {
+                    // at=agent with nothing generated yet: the position is the end of the answer this
+                    // request produces, where the live state will already sit - nothing to plan here.
+                    // `snap` writes the file when generation ends; `ckpt` has nothing to write, it
+                    // tells the eviction dump which state to keep. A `ckpt` used to become a file
+                    // here, kind ignored - 2 GB of SSD at 100k tokens that nobody asked for.
+                    if (!h.live) {
+                        continue;   // an old "at=agent" in history: that answer exists, nothing pending
+                    }
+                    if (h.kind == 0) {
+                        slot.snap_hint_at_gen = true;
+                    } else {
+                        slot.hint_gen_ckpt = true;
+                    }
+                    slot.stats.tel_hints++;
+                    SLT_INF(slot, "[hint] %s: armed for the end of generation\n", h.desc.c_str());
+                    continue;
+                }
+                if (h.n_tokens <= 0 || h.n_tokens >= n_prompt) {
+                    SLT_WRN(slot, "[hint] %s: dropped, outside this prompt (1..%d)\n", h.desc.c_str(), n_prompt - 1);
+                    slot.stats.tel_hints_dropped++;
+                    continue;
+                }
+
+                const int32_t H = snapshot_align_media(slot.task->tokens, h.n_tokens);
+
+                if (!h.live) {
+                    // [ANALYZER] carried along from an earlier turn. Whatever is still there is kept
+                    // - a checkpoint softly pinned, a file touched - but nothing is planned, nothing
+                    // rolled back, nothing counted: the conversation has moved past this position.
+                    if (h.kind == 1) {
+                        for (const auto & ck : slot.prompt.checkpoints) {
+                            if (ck.n_tokens == H) {
+                                if (std::find(slot.ckpt_pinned_soft.begin(), slot.ckpt_pinned_soft.end(), H) == slot.ckpt_pinned_soft.end()) {
+                                    slot.ckpt_pinned_soft.push_back(H);
+                                }
+                                break;
+                            }
+                        }
+                    } else if (!snapshot_path.empty()) {
+                        const std::string name = snapshot_name(snapshot_hash(toks, H), H);
+                        const std::string path = snapshot_path + "/" + name;
+                        if (std::filesystem::exists(path)) {
+                            snapshot_touch(name, path);
+                        }
+                    }
+                    SLT_DBG(slot, "[hint] %s: historic, kept if present\n", h.desc.c_str());
+                    continue;
+                }
+
+                if (h.kind == 0) {
+                    if (snapshot_path.empty()) {
+                        SLT_WRN(slot, "[hint] %s: dropped, --snapshot-path is not set\n", h.desc.c_str());
+                        slot.stats.tel_hints_dropped++;
+                        continue;
+                    }
+                    const std::string name = snapshot_name(snapshot_hash(toks, H), H);
+                    const std::string path = snapshot_path + "/" + name;
+                    if (std::filesystem::exists(path)) {
+                        snapshot_touch(name, path);
+                        SLT_INF(slot, "[hint] %s: already on disk at %d, refreshed\n", h.desc.c_str(), H);
+                        slot.stats.tel_hints++;
+                        continue;
+                    }
+                } else {
+                    bool have = false;
+                    for (const auto & ck : slot.prompt.checkpoints) {
+                        if (ck.n_tokens == H) {
+                            have = true;
+                            break;
+                        }
+                    }
+                    if (std::find(slot.ckpt_pinned.begin(), slot.ckpt_pinned.end(), H) == slot.ckpt_pinned.end()) {
+                        slot.ckpt_pinned.push_back(H);
+                    }
+                    if (have) {
+                        SLT_INF(slot, "[hint] %s: checkpoint already at %d\n", h.desc.c_str(), H);
+                        slot.stats.tel_hints++;
+                        continue;
+                    }
+                }
+
+                if (H < n_past) {
+                    // the floor pass before the checkpoint search had its chance; if we are still here
+                    // the roll-back was too expensive or there was no checkpoint to roll back to.
+                    SLT_WRN(slot, "[hint] %s: dropped, position %d is %d tokens behind the prefill (budget %d)\n",
+                            h.desc.c_str(), H, n_past - H, snap_hint_budget());
+                    slot.stats.tel_hints_dropped++;
+                    continue;
+                }
+
+                add_stop(H, h.kind == 0, h.kind == 1, true);
+                slot.stats.tel_hints++;
+                SLT_INF(slot, "[hint] %s: stop planned at %d (prefill stands at %d)\n", h.desc.c_str(), H, n_past);
+            }
+        }
+
+        std::sort(slot.snap_stops.begin(), slot.snap_stops.end(),
+                  [](const auto & a, const auto & b) { return a.n < b.n; });
+        slot.snap_stops_advance();
+    }
+
+    // [ANALYZER] at=agent with nothing generated yet names the end of the answer this request
+    // produces. That is where the live state sits the moment generation stops, so this is the
+    // cheapest snapshot there is: no roll-back, no re-prefill, nothing to plan. It is also the
+    // position a harness that echoes reasoning back resumes from, which is why it is worth naming.
+    void snap_hint_gen_save(server_slot & slot) {
+        if (!slot.snap_hint_at_gen) {
+            return;
+        }
+        slot.snap_hint_at_gen = false;
+        if (snapshot_path.empty() || slot.task == nullptr) {
+            return;
+        }
+        const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+        const int32_t   n       = std::min<int32_t>(pos_max + 1, (int32_t) slot.prompt.tokens.size());
+        if (n <= 0) {
+            return;
+        }
+        if (snapshot_save(slot, slot.prompt.tokens, n)) {
+            slot.snap_cover = std::max(slot.snap_cover, n);
+            slot.stats.tel_snap_saved = n;
+            SLT_INF(slot, "[hint] snapshot at the end of generation: %d tokens\n", n);
+        }
+    }
+
+    // the prefill has reached a planned stop: do what was planned there and arm the next one
+    void snap_stop_execute(server_slot & slot) {
+        const int32_t n = slot.prompt.n_tokens();
+        for (auto & st : slot.snap_stops) {
+            if (st.n != n) {
+                continue;
+            }
+            if (st.snap) {
+                if (snapshot_save(slot, slot.task->tokens, n)) {
+                    slot.snap_cover = std::max(slot.snap_cover, n);
+                    slot.stats.tel_snap_saved = n;
+                    SLT_INF(slot, "[hint] snapshot written at %d%s\n", n, st.hinted ? " (hinted)" : "");
+                }
+            }
+            // the checkpoint itself is created by the normal path, which runs just before the decode
+            // of the batch that starts here and therefore covers exactly this position
+            st.n = 0;
+        }
+        slot.snap_stops_advance();
+    }
+
+    // [KV_SHARE] once a prompt is fully in the slot, hand the cells of any prefix it shares with another
+    // slot over to that slot's copy: identical tokens at identical positions produce identical KV, so one
+    // physical copy serves both. done AFTER the prefill (operator's insight), which makes it independent of
+    // how the prompt got there - prefilled, restored from a snapshot, or a mix - and keeps the recurrent
+    // state out of it entirely, since each slot then already holds its own correct one.
+    //
+    // order matters: drop our own cells for [0, n) first, then borrow. seq_rm(seq, 0, n) leaves the
+    // recurrent state alone because its single cell sits at the sequence end, i.e. behind n. seq_cp does
+    // clobber it (it ignores p0/p1 and just re-points the tail), so we save and restore it around the
+    // call - with PARTIAL_ONLY, which the hybrid memory routes to the recurrent part only.
+    void kv_share_merge(server_slot & slot) {
+        if (kv_share_min <= 0 || !params_base.kv_unified || slot.prompt.tokens.size() == 0) {
+            return;
+        }
+
+        server_slot * from = nullptr;
+        size_t n_share = 0;
+        for (auto & other : slots) {
+            if (other.id == slot.id || other.prompt.tokens.size() == 0) {
+                continue;
+            }
+            const size_t lcp = other.prompt.tokens.get_common_prefix(slot.prompt.tokens);
+            if (lcp > n_share) {
+                n_share = lcp;
+                from    = &other;
+            }
+        }
+        if (from == nullptr || n_share < (size_t) kv_share_min) {
+            return;
+        }
+        // never hand over our whole sequence: we must keep at least the last token, and a prefix that
+        // already covers everything means the slot picker should have reused that slot instead
+        n_share = std::min(n_share, slot.prompt.tokens.size() - 1);
+        if (n_share < (size_t) kv_share_min) {
+            return;
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        std::vector<uint8_t> rs;
+        {
+            const size_t need = llama_state_seq_get_size_ext(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            rs.resize(need);
+            const size_t got = llama_state_seq_get_data_ext(ctx_tgt, rs.data(), rs.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            if (got == 0) {
+                SLT_WRN(slot, "%s", "[kv-share] cannot save the recurrent state, skipping merge\n");
+                return;
+            }
+            rs.resize(got);
+        }
+
+        slot.mem.seq_rm(slot.id, 0, (llama_pos) n_share);
+        slot.mem.seq_cp(from->id, slot.id, 0, (llama_pos) n_share);
+
+        if (llama_state_seq_set_data_ext(ctx_tgt, rs.data(), rs.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == 0) {
+            SLT_ERR(slot, "%s", "[kv-share] failed to restore the recurrent state after merge\n");
+            slot.prompt_clear();
+            return;
+        }
+
+        const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+        if (pos_max != (llama_pos) slot.prompt.tokens.size() - 1) {
+            SLT_WRN(slot, "[kv-share] merge left the sequence inconsistent (pos_max = %d, expected %zu), dropping slot\n",
+                    pos_max, slot.prompt.tokens.size() - 1);
+            slot.prompt_clear();
+            return;
+        }
+
+        slot.stats.tel_merged = (int32_t) n_share;
+        SLT_INF(slot, "[kv-share] merged %zu of %zu cells into slot %d in %.0f ms (%.2f GB of KV freed)\n",
+                n_share, slot.prompt.tokens.size(), from->id, (ggml_time_us() - t0) / 1000.0,
+                n_share * 42.6 / 1024 / 1024);
+    }
+
+    // the longest disk snapshot whose tokens are a prefix of this prompt: {length, file name}, {0, ""}
+    // if none. one pass over the prompt, probing every known snapshot length (streaming FNV-1a).
+    std::pair<int32_t, std::string> snapshot_lookup(const server_tokens & tokens) const {
+        std::pair<int32_t, std::string> best = {0, ""};
+        if (snapshot_path.empty() || snapshot_lengths.empty() || tokens.size() < 2) {
+            return best;
+        }
+
+        const llama_tokens toks = snapshot_key_tokens(tokens);
+
+        // a snapshot must leave at least one token to decode
+        const size_t lim = toks.size() - 1;
+
+        // must start from the SAME basis as snapshot_hash(), i.e. seeded with this model's identity -
+        // otherwise the names computed here can never match the names on disk and every file written
+        // is invisible to the lookup that is supposed to find it.
+        uint64_t h = snapshot_model_seed;
+        size_t   i = 0;
+        for (int32_t n : snapshot_lengths) {
+            if ((size_t) n > lim) {
+                break;
+            }
+            for (; i < (size_t) n; ++i) {
+                h ^= (uint64_t)(uint32_t) toks[i];
+                h *= 1099511628211ull;
+            }
+            const std::string cand = snapshot_name(h, n);
+            if (snapshot_files.count(cand)) {
+                best = {n, cand};
+            }
+        }
+        return best;
+    }
+
+    // restores the snapshot `found` (from snapshot_lookup) into the slot; returns its length, 0 on failure
+    int snapshot_try_load(server_slot & slot, const std::pair<int32_t, std::string> & found) {
+        const int32_t     n_sel = found.first;
+        const std::string name  = found.second;
+        if (n_sel == 0) {
+            return 0;
+        }
+
+        const llama_tokens toks = snapshot_key_tokens(slot.task->tokens);
+        const std::string  path = snapshot_path + "/" + name;
+
+        std::ifstream f(path, std::ios::binary);
+        if (!f) {
+            SLT_WRN(slot, "[snapshot] file vanished, dropping from index: %s\n", path.c_str());
+            snapshot_forget(name, false);
+            return 0;
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        char magic[4]; f.read(magic, 4);
+        uint32_t version = 0, n_ubatch = 0, n_ctx_seq = 0, n_tokens = 0;
+        uint64_t model_size = 0, n_params = 0;
+        const bool hdr_ok = f && memcmp(magic, "LSNP", 4) == 0 && rd(f, version) && version == 3;
+        if (!hdr_ok ||
+            !rd(f, model_size) || !rd(f, n_params) || !rd(f, n_ubatch) || !rd(f, n_ctx_seq) || !rd(f, n_tokens)) {
+            SLT_WRN(slot, "[snapshot] bad header: %s\n", path.c_str());
+            return 0;
+        }
+        if (model_size != llama_model_size(model_tgt) || n_params != llama_model_n_params(model_tgt) ||
+            n_ubatch != llama_n_ubatch(ctx_tgt) || n_ctx_seq != llama_n_ctx_seq(ctx_tgt) || (int32_t) n_tokens != n_sel) {
+            SLT_WRN(slot, "[snapshot] configuration mismatch, ignoring %s\n", path.c_str());
+            snapshot_forget(name, false);
+            return 0;
+        }
+
+        llama_tokens saved(n_tokens);
+        f.read((char *) saved.data(), (size_t) n_tokens * sizeof(llama_token));
+        if (!f || !std::equal(saved.begin(), saved.end(), toks.begin())) {
+            SLT_WRN(slot, "[snapshot] token mismatch (hash collision?), ignoring %s\n", path.c_str());
+            return 0;
+        }
+
+        common_prompt_checkpoint ck;
+        if (!rd_blob(f, ck.data_tgt) || !rd_blob(f, ck.data_dft) || !rd_blob(f, ck.data_spec)) {
+            SLT_WRN(slot, "[snapshot] truncated: %s\n", path.c_str());
+            return 0;
+        }
+        ck.update_pos(n_tokens, 0, n_tokens - 1);
+
+        // the slot must be empty: drop whatever it held, then restore the full state
+        slot.mem.seq_rm(slot.id, -1, -1);
+        ck.load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        if (ctx_dft && !ck.data_dft.empty()) {
+            ck.load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        }
+        if (slot.spec && !ck.data_spec.empty()) {
+            common_speculative_set_state(slot.spec, slot.id, ck.data_spec);
+        }
+
+        // the slot now holds the first n_sel tokens of the task, images included
+        slot.prompt.tokens = slot.task->tokens.clone();
+        slot.prompt.tokens.keep_first(n_sel);
+        slot.prompt.checkpoints.clear();
+
+        // remember the use, on disk too, so LRU order survives restarts
+        snapshot_files[name].last_used = snapshot_now();
+        {
+            std::error_code ec;
+            std::filesystem::last_write_time(path, std::filesystem::file_time_type::clock::now(), ec);
+        }
+
+        SLT_INF(slot, "[snapshot] restored %u tokens, %.1f MB in %.0f ms <- %s\n",
+                n_tokens, ck.size() / 1e6, (ggml_time_us() - t0) / 1000.0, path.c_str());
+        return (int) n_tokens;
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // ---------------------------------------------------------------------------------------------
+    // [PREFIX] which prefix has earned a file on disk
+    // ---------------------------------------------------------------------------------------------
+    //
+    // The unit is the PREAMBLE: everything a client sends before anyone has said anything - system
+    // prompt and tool definitions, up to the START of the first user message. Before it lies what
+    // several conversations have in common; after it lies one conversation, and where that diverges
+    // from ITSELF is the probe's business, not an index's across sessions.
+    //
+    // Two conversations can share a prefix in two different ways, and both earn a file:
+    //
+    //   - the SAME preamble, used by a second conversation. The shared depth is its full length.
+    //
+    //     What counts as "another conversation" is decided by the SLOT, not by content: a prompt
+    //     counts when it arrived fresh, i.e. no slot took it as a continuation of its own tail.
+    //     A session extending itself matches a slot and does not count. Identifying conversations
+    //     by their first user message instead would miss a FORKED chat whose branches both live
+    //     on - they share that message, and the second branch would never earn the file it needs
+    //     (operator, 2026-09-15). The tail is what has to match; where it does not, this is a
+    //     different conversation reusing the slot.
+    //
+    //   - DIFFERENT preambles that agree for a while and then part. This is the common case in
+    //     practice, not an exotic one: a system prompt whose memory or context block sits at its
+    //     end diverges in the MIDDLE - measured here at tokens 5981, 6131 and 6257 across three
+    //     generations of the same assistant (operator, 2026-09-15). The shared depth is where they
+    //     part, and a file there serves every generation.
+    //
+    // One rule covers both: ask every other conversation how deep it reaches with this one, and
+    // take the depth that --prefix-min-forks of them reach. At the default of one that is simply
+    // the deepest another conversation gets - so the file appears on the SECOND one.
+    //
+    // The horizon is handled and not pretended away: entries are kept up to --prefix-max-compare
+    // tokens, and when a comparison runs to the end of a TRUNCATED entry the two are identical as
+    // far as anything was kept - where they really part is unknown, so that pair contributes
+    // nothing. Reporting the cap as a fork is how a snapshot once landed at exactly 32768 tokens,
+    // at a position no prompt ever diverged at.
+
+    struct prefix_entry {
+        uint64_t              id;    // FNV-1a over the WHOLE preamble: identity
+        int32_t               n;     // its true length in tokens
+        bool                  cut;   // head is truncated: its real length is beyond what we kept
+        llama_tokens          head;  // the first min(n, prefix_max_compare) tokens
+        int32_t               uses;  // conversations seen with this preamble (see below)
+    };
+    std::deque<prefix_entry> prefix_index;
+
+    static size_t common_len(const llama_tokens & a, const llama_tokens & b) {
+        const size_t m = std::min(a.size(), b.size());
+        size_t l = 0;
+        while (l < m && a[l] == b[l]) {
+            ++l;
+        }
+        return l;
+    }
+
+    // The preamble of this prompt and the hash of the conversation that follows it. false when the
+    // prompt has no usable preamble: no parsed first message (a raw completion, or a template whose
+    // delimiters did not match), or shorter than the floor.
+    bool prefix_split(const server_slot & slot, const llama_tokens & toks,
