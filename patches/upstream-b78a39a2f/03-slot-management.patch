+#!/usr/bin/env python3
+"""
+The hint channel, end to end: does a marker produce the checkpoint or file it names, where it
+names it - and nothing else?
+
+    BASE=http://127.0.0.1:8099 python3 hints-test.py <telemetry.jsonl>
+
+Run against a server started with --snapshot-path, --ctx-checkpoints 3 and --kv-unified
+(cap 3 on purpose: historic hints have to lose against the cap without fighting back).
+The LLM is simulated as in suite.py; a real GGUF is needed only for tokenizer and template.
+
+Cases:
+  A  ckpt at=user-1, more than a batch before the prompt end -> the checkpoint exists there.
+     (The mid-prompt gate used to win over the hint: "stop planned", hint counted, no checkpoint.)
+  B  ckpt at=user-1 behind the prefill on a continuation -> rolled back within budget, created.
+  C  a ckpt marker carried along in history every turn -> old positions are HISTORIC: never
+     rolled back to, evicted before the current declaration, no re-prefill.
+  D  ckpt at=agent with nothing generated -> no file written, hint counted; the end of the
+     answer is what the eviction dump keeps.
+  E  snap at=user-1 mid-prompt -> the file exists, at that length.
+"""
+import json, os, sys, time, urllib.request
+
+BASE = os.environ.get("BASE", "http://127.0.0.1:8099")
+TEL  = sys.argv[1]
+SECRET = "T3ST-S3CR3T"
+F = ("memory bandwidth kernel tensor matrix gradient throughput pipeline register quantisation " * 12)
+SYS = {"role": "system", "content": "You are terse.\n<<llama-snap enable secret=" + SECRET + ">>"}
+
+def post(path, body):
+    r = urllib.request.Request(BASE + path, data=json.dumps(body).encode(),
+                               headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(r, timeout=600) as f:
+        return json.load(f)
+
+def infer(msgs, mt=1):
+    post("/v1/chat/completions", {"messages": msgs, "max_tokens": mt, "temperature": 0})
+    time.sleep(0.3)
+    rows = [json.loads(l) for l in open(TEL) if l.strip()]
+    return rows[-1]
+
+def snap_dir():
+    return post("/props", {}) if False else None
+
+findings = []
+def check(cond, msg):
+    if not cond:
+        findings.append(msg)
+
+# A
+r = infer([SYS, {"role": "user", "content": "First question. " + F[:200]},
+           {"role": "assistant", "content": "First answer."},
+           {"role": "user", "content": "Second, very long question. " + F * 30 +
+            "\n<<llama-snap ckpt secret=" + SECRET + " at=user-1>>"}])
+H = min(r["checkpoints"]) if r["checkpoints"] else -1
+check(r.get("hints") == 1 and len(r["checkpoints"]) >= 2 and H < r["n_prompt"] - 2048,
+      f"A: ckpt far before the end not created: hints {r.get('hints')} checkpoints {r['checkpoints']} of {r['n_prompt']}")
+
+# B
+m = [SYS, {"role": "user", "content": "Alpha question. " + F[:300]}]
+infer(m)
+m += [{"role": "assistant", "content": "Alpha answer."},
+      {"role": "user", "content": "Beta question. " + F[:100] + "\n<<llama-snap ckpt secret=" + SECRET + " at=user-1>>"}]
+r = infer(m)
+check(r.get("hints") == 1 and r.get("hint_reprefill", 0) > 0 and r["restore_at"] < r["lcp"],
+      f"B: hint behind the prefill not rolled back to: reprefill {r.get('hint_reprefill')} restore {r['restore_at']} lcp {r['lcp']}")
+check(r["restore_at"] in r["checkpoints"], f"B: no checkpoint at the hinted position {r['restore_at']}: {r['checkpoints']}")
+
+# C
+m = [SYS]
+last = None
+for i in range(4):
+    m.append({"role": "user", "content": f"Gamma {i}. " + F[:150] + "\n<<llama-snap ckpt secret=" + SECRET + ">>"})
+    r = infer(m)
+    if i > 0:
+        check(r.get("hints") == 1, f"C{i}: historic markers counted as hints: {r.get('hints')}")
+        check(r.get("hint_reprefill", 0) == 0 and r["restore_at"] == r["lcp"],
+              f"C{i}: a historic hint caused a roll-back: reprefill {r.get('hint_reprefill')} restore {r['restore_at']} lcp {r['lcp']}")
+    m.append({"role": "assistant", "content": f"Gamma answer {i}."})
+    last = r
+
+# D
+r = infer([SYS, {"role": "user", "content": "Fourth question. " + F * 8 +
+                 "\n<<llama-snap ckpt secret=" + SECRET + " at=agent>>"}], mt=8)
+check(r.get("hints") == 1 and r.get("snap_saved", 0) == 0,
+      f"D: ckpt at=agent: hints {r.get('hints')} snap_saved {r.get('snap_saved')} (a ckpt must not become a file)")
+
+# E
+r = infer([SYS, {"role": "user", "content": "Other first question. " + F[:200]},
+           {"role": "assistant", "content": "First answer."},
+           {"role": "user", "content": "Second, long question. " + F * 8 +
+            "\n<<llama-snap snap secret=" + SECRET + " at=user-1>>"}])
+check(r.get("hints") == 1 and 0 < r.get("snap_saved", 0) < 200,
+      f"E: snap at=user-1 not written where named: snap_saved {r.get('snap_saved')} of {r['n_prompt']}")
+
+# F: a ckpt marker in a SYSTEM message that arrives mid-conversation, after the last assistant -
+#    that is a conversation position and a live one; only the leading system block is off limits.
+#    (Needs a template that renders such a message; the model's own may refuse it with an error.)
+try:
+    r = infer([SYS, {"role": "user", "content": "Delta question. " + F[:300]},
+               {"role": "assistant", "content": "Delta answer."},
+               {"role": "system", "content": "Status: continue.\n<<llama-snap ckpt secret=" + SECRET + ">>"},
+               {"role": "user", "content": "Epsilon question. " + F[:100]}])
+    check(r.get("hints") == 1 and len(r["checkpoints"]) >= 2,
+          f"F: ckpt in a mid-conversation system message not honoured: hints {r.get('hints')} checkpoints {r['checkpoints']}")
+except Exception as e:
+    print("  F skipped: the template refuses a mid-conversation system message:", str(e)[:80])
+
+for f in findings:
+    print("  !", f)
+print(f"  hints: {len(findings)} finding(s)")
+sys.exit(1 if findings else 0)
