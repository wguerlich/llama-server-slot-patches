+                        (double) telemetry_prompt_bytes / 1e9, telemetry_prompt_dir.c_str(),
+                        (double) telemetry_prompt_budget / 1e9);
+            }
+            telemetry_prompt_logged = telemetry_prompt_bytes;
+        }
+        {
+            // ms offsets from the start of prompt processing; a phase that did not happen stays null
+            auto off = [&](int64_t t) {
+                return t > 0 && st.t_start > 0
+                    ? std::to_string((t - st.t_start) / 1000.0) : std::string("null");
+            };
+            std::ofstream f(std::string(stem) + ".json");
+            f << "{\n";
+            f << "  \"t_start_us\": " << t0_wall << ",\n";
+            f << "  \"slot\": " << slot.id << ", \"n_prompt\": " << toks.size() << ",\n";
+            f << "  \"metrics\": {\"n_cached\": " << st.n_prompt_cached
+              << ", \"n_new\": " << st.n_prompt_processed
+              << ", \"n_gen\": " << st.n_gen
+              << ", \"cls\": " << st.tel_class
+              << ", \"n_grow\": " << st.tel_n_grow
+              << ", \"cont\": " << (st.tel_continuation ? "true" : "false")
+              << ", \"next_turn\": " << (st.tel_next_turn ? "true" : "false")
+              << ", \"lcp\": " << st.tel_lcp
+              << ", \"slot_len\": " << st.tel_slot_len
+              << ", \"snapshot_at\": " << st.tel_snap_p
+              << ", \"restore_at\": " << st.tel_restore_at
+              << ", \"snap_loaded\": " << st.tel_snap_loaded
+              << ", \"snap_saved\": " << st.tel_snap_saved
+              << ", \"merged\": " << st.tel_merged
+              << ", \"kv_depth\": " << st.tel_kv_depth
+              << ", \"slots_used\": " << st.tel_slots_used << "},\n";
+            f << "  \"phases_ms\": {\"pick\": " << off(st.t_pick)
+              << ", \"launch\": " << off(st.t_launch)
+              << ", \"prompt_start\": 0"
+              << ", \"snapshot_begin\": " << off(st.t_snap_begin)
+              << ", \"snapshot_end\": " << off(st.t_snap_end)
+              << ", \"checkpoint\": " << off(st.t_ckpt)
+              << ", \"prefill_end\": " << off(st.t_prompt_last)
+              << ", \"merge_begin\": " << off(st.t_merge_begin)
+              << ", \"merge_end\": " << off(st.t_merge_end)
+              << ", \"gen_end\": " << off(st.t_gen_last)
+              << ", \"release\": " << off(mono_now) << "},\n";
+            f << "  \"checkpoints\": [" << ckpt_list(slot) << "],\n";
+            f << "  \"picker\": \"";
+            for (char c : slot.trace) {
+                if (c == '\n') { f << "\\n"; } else if (c == '"') { f << "\\\""; } else { f << c; }
+            }
+            f << "\"\n}\n";
+        }
+    }
+
+    // [SLOT_EVICT] the fingerprint is no longer a gate on slot selection. operator decision
+    // 2026-09-09: a slot that has a usable checkpoint at all is worth taking, because every other
+    // slot means a full prefill. the tail stays where it belongs - placing the turn-boundary
+    // checkpoint. see RUNBOOK.md, "Slot eviction", for the case that would argue otherwise (a
+    // checkpoint far from the prompt end); it does not occur under the current checkpoint regime,
+    // and the picker trace in the telemetry would show it if it ever did.
+    static constexpr size_t next_turn_slack = 8;
+
+    static bool ctx_tail_seen_in(const server_slot & slot, const server_tokens & input, int32_t hint) {
+        if (slot.ctx_tails.empty()) {
+            return false;
+        }
+        const auto & tail = slot.ctx_tails.back();
+        const size_t n = input.size();
+        if (tail.empty() || n <= tail.size() + 1) {
+            return false;
+        }
+        const size_t last = n - tail.size() - 1;   // strictly inside: may not end at n
+        const size_t from = std::min((size_t) std::max(0, hint), last);
+        for (size_t k = 0; k <= last; ++k) {
+            // walk outwards from the expected position: down first, then up
+            const size_t pos = k <= from ? from - k : k;
+            if (pos > last) {
+                continue;
+            }
+            bool eq = true;
+            for (size_t i = 0; i < tail.size() && eq; ++i) {
+                eq = input[pos + i] == tail[i];
+            }
+            if (eq) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool ctx_tail_seen_inside(const server_slot & slot) const {
+        return slot.task ? ctx_tail_seen_in(slot, slot.task->tokens, slot.snap_prompt_last) : false;
+    }
+
+    // [SNAPSHOT] disk snapshots of shared prompt prefixes
+    //
+    // a snapshot is the FULL sequence state (attention KV + recurrent state + draft + speculative
+    // state) after the first n tokens of a prompt, written to disk while that prompt is being
+    // prefilled - between two batches, exactly like a context checkpoint but with flags 0 instead
+    // of PARTIAL_ONLY, so it can be restored into an EMPTY slot. a later prompt that starts with the
+    // same n tokens restores it and prefills only the rest.
+    //
+    // file layout (little endian): "LSNP" u32 version
+    //   | u32 info_bytes, info_bytes of HARNESS INFO   (version >= 2 only)
+    //   | u64 model_size u64 n_params u32 n_ubatch
+    // u32 n_ctx_seq | u32 n_tokens, n_tokens x i32 | u64 len + data (tgt) | u64 len + data (dft)
+    // | u64 len + data (spec). the header refuses states from another model or configuration -
+    // a mismatched state would not fail loudly, it would produce garbage.
+    //
+
+    static uint64_t snapshot_hash(const llama_tokens & toks, size_t n) {
+        uint64_t h = 1469598103934665603ull; // FNV-1a
+        for (size_t i = 0; i < n && i < toks.size(); ++i) {
+            h ^= (uint64_t)(uint32_t) toks[i];
+            h *= 1099511628211ull;
+        }
+        return h;
+    }
+
+    // the prompt as a hashable/comparable token sequence, positions preserved: text tokens as they
+    // are, every image replaced by pseudo tokens derived from its chunk id (bit 30 set, so they can
+    // never equal a vocabulary token). two prompts with the same text and different images diverge
+    // at the image start; with the same image they agree through it.
+    static llama_tokens snapshot_key_tokens(const server_tokens & t) {
+        llama_tokens k(t.size());
+        for (size_t i = 0; i < t.size(); ++i) {
+            k[i] = t[i];
+        }
+        for (const auto & r : t.media_ranges()) {
+            uint64_t h = 1469598103934665603ull;
+            for (unsigned char c : r.id) {
+                h ^= c;
+                h *= 1099511628211ull;
+            }
+            for (size_t j = 0; j < r.n && r.start + j < k.size(); ++j) {
+                h = h * 6364136223846793005ull + 1442695040888963407ull;
+                k[r.start + j] = (llama_token) (0x40000000u | (uint32_t) (h >> 34));
+            }
+        }
+        return k;
+    }
+
+    // a snapshot position must not fall inside an image (the KV of a half image is meaningless and
+    // keep_first() refuses it): move it back to the image start
+    static int32_t snapshot_align_media(const server_tokens & t, int32_t pos) {
+        for (const auto & r : t.media_ranges()) {
+            if ((size_t) pos > r.start && (size_t) pos < r.start + r.n) {
+                return (int32_t) r.start;
+            }
+        }
+        return pos;
+    }
+
+    static std::string snapshot_name(uint64_t h, size_t n) {
+        char buf[32];
+        snprintf(buf, sizeof(buf), "%016llx", (unsigned long long) h);
+        return std::string(buf) + "-" + std::to_string(n) + ".lsnp";
+    }
+
+    std::string snapshot_file(const llama_tokens & toks, size_t n) const {
+        return snapshot_path + "/" + snapshot_name(snapshot_hash(toks, n), n);
+    }
+
+    template <typename T> static void wr(std::ofstream & f, const T & v) { f.write((const char *) &v, sizeof(v)); }
+    template <typename T> static bool rd(std::ifstream & f, T & v) { f.read((char *) &v, sizeof(v)); return (bool) f; }
+
+    static void wr_blob(std::ofstream & f, const std::vector<uint8_t> & b) {
+        uint64_t n = b.size(); wr(f, n);
+        if (n) f.write((const char *) b.data(), n);
+    }
+    static bool rd_blob(std::ifstream & f, std::vector<uint8_t> & b) {
+        uint64_t n = 0;
+        if (!rd(f, n) || n > (1ull << 36)) return false;
+        b.resize(n);
+        if (n) f.read((char *) b.data(), n);
+        return (bool) f;
+    }
+
+    static int64_t snapshot_now() {
+        return std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+    }
+
+    // drop a file from the index (and optionally from disk); keeps snapshot_lengths consistent
+    // `name` by value: callers pass a map key that this function erases
+    void snapshot_forget(std::string name, bool unlink) {
+        auto it = snapshot_files.find(name);
+        if (it == snapshot_files.end()) {
+            return;
+        }
+        snapshot_bytes -= std::min(snapshot_bytes, it->second.size);
+        snapshot_files.erase(it);
+        if (unlink) {
+            std::error_code ec;
+            std::filesystem::remove(snapshot_path + "/" + name, ec);
+        }
+        snapshot_lengths.clear();
+        for (const auto & kv : snapshot_files) {
+            int32_t n = 0;
+            if (sscanf(kv.first.c_str() + 17, "%d", &n) == 1) {
+                snapshot_lengths.insert(n);
+            }
+        }
+    }
+
+    // make room for a new snapshot of `need` bytes: least recently used files go first.
+    // returns false if the budget cannot hold it even after evicting everything else.
+    bool snapshot_make_room(server_slot & slot, size_t need) {
+        if (snapshot_max_bytes == 0) {
+            return true;
+        }
+        if (need > snapshot_max_bytes) {
+            SLT_WRN(slot, "[snapshot] %.1f MB exceeds the whole budget of %.1f MB, not saving\n", need / 1e6, snapshot_max_bytes / 1e6);
+            return false;
+        }
+        while (snapshot_bytes + need > snapshot_max_bytes && !snapshot_files.empty()) {
+            auto victim = snapshot_files.begin();
+            for (auto it = snapshot_files.begin(); it != snapshot_files.end(); ++it) {
+                if (it->second.last_used < victim->second.last_used) {
+                    victim = it;
+                }
+            }
+            SLT_INF(slot, "[snapshot] budget: evicting %s (%.1f MB, last used %llds ago)\n",
+                    victim->first.c_str(), victim->second.size / 1e6, (long long) (snapshot_now() - victim->second.last_used));
+            snapshot_forget(victim->first, true);
+        }
+        return true;
+    }
+
+    // called between batches, when exactly n_tokens of the slot's prompt have been decoded
+    // [SNAPSHOT] harness info block, length-prefixed so it can grow without a format bump.
+    //
+    // What a client does with the conversation history is a property of the HARNESS, not of this
+    // file - and the file is the only thing sessions of the same harness share, so this is where
+    // such knowledge belongs. A reader takes the fields it knows and seeks past the rest, so adding
+    // a field never invalidates existing snapshots and never needs version 3.
+    //
+    // Field 0, u32 type: which resume points a session of this harness actually used, as a bitmask
+    // over snapshot-evict-points (1 = end of generation, i.e. the client sends reasoning back;
+    // 2 = newest checkpoint, reasoning stripped; 4 = second-newest, only the last one kept).
+    // 0 = not known when this file was written.
+    //
+    // Candidates for further fields, all observed but not yet recorded: how many tokens before the
+    // prompt end a follow-up actually diverges (a client that wraps history in a container diverges
+    // at the closing tag, measured 11 tokens, which is behind the L-4 checkpoint), and whether the
+    // rendered prompt end is re-tokenized on continuation (the seam).
+    struct harness_info {
+        uint32_t type = 0;
+    };
+    static constexpr uint32_t harness_info_bytes = sizeof(uint32_t);   // grows as fields are added
+
+    static uint32_t harness_type_of(const server_slot & slot) {
+        return (slot.evict_hits[0] > 0 ? 1u : 0u)
+             | (slot.evict_hits[1] > 0 ? 2u : 0u)
+             | (slot.evict_hits[2] > 0 ? 4u : 0u);
+    }
+
+    bool snapshot_save(server_slot & slot, const server_tokens & tokens, int n_tokens) {
+        const llama_tokens toks = snapshot_key_tokens(tokens);
+        if ((int) toks.size() < n_tokens) {
+            return false;
+        }
+
+        const std::string path = snapshot_file(toks, n_tokens);
+
+        if (std::filesystem::exists(path)) {
+            return false; // already have it
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        common_prompt_checkpoint ck;
+        ck.update_pos(n_tokens, 0, n_tokens - 1);
+        ck.update_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        if (ctx_dft) {
+            ck.update_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        }
+        if (slot.spec) {
+            common_speculative_get_state(slot.spec, slot.id, ck.data_spec);
+        }
+
+        if (!snapshot_make_room(slot, ck.size())) {
+            return false;
+        }
+
+        std::ofstream f(path + ".tmp", std::ios::binary);
+        if (!f) {
+            SLT_WRN(slot, "[snapshot] cannot write %s\n", path.c_str());
+            return false;
+        }
+        f.write("LSNP", 4);
+        wr(f, (uint32_t) 2);
+        wr(f, harness_info_bytes);
+        wr(f, harness_type_of(slot));
+        wr(f, (uint64_t) llama_model_size(model_tgt));
+        wr(f, (uint64_t) llama_model_n_params(model_tgt));
+        wr(f, (uint32_t) llama_n_ubatch(ctx_tgt));
+        wr(f, (uint32_t) llama_n_ctx_seq(ctx_tgt));
+        wr(f, (uint32_t) n_tokens);
+        f.write((const char *) toks.data(), (size_t) n_tokens * sizeof(llama_token));
+        wr_blob(f, ck.data_tgt);
+        wr_blob(f, ck.data_dft);
+        wr_blob(f, ck.data_spec);
+        f.close();
+
+        std::error_code ec;
+        std::filesystem::rename(path + ".tmp", path, ec);
+
+        snapshot_files[snapshot_name(snapshot_hash(toks, n_tokens), n_tokens)] = {ck.size(), snapshot_now()};
+        snapshot_lengths.insert(n_tokens);
+        snapshot_bytes += ck.size();
+
+        SLT_INF(slot, "[snapshot] saved %d tokens, %.1f MB in %.0f ms -> %s\n",
+                n_tokens, ck.size() / 1e6, (ggml_time_us() - t0) / 1000.0, path.c_str());
+        return true;
+    }
+
+    // a slot that served a growing session is about to lose its content: keep it on disk at every context
+    // checkpoint position, rolling back. the roll-back is the server's own checkpoint-restore trick: load
+    // the recurrent state of the checkpoint (PARTIAL_ONLY), then seq_rm() everything behind it; the
+    // attention cells up to there are still in place, so the sequence is now a complete state at that
+    // position. descending, since every step truncates. the newest checkpoint sits at L-4 of the last
+    // prompt - exactly where a returning turn diverges when the template strips the thinking from the
+    // history. the decoded length itself is not kept: with stripped thinking it can never match.
+    // the slot is unusable afterwards - callers clear it.
+    void snapshot_dump_slot(server_slot & slot) {
+        SLT_DBG(slot, "[snapshot] dump check: n = %zu, n_grow = %d (need %d), points = 0x%x\n",
+                slot.prompt.tokens.size(), slot.n_grow, snapshot_evict_turns, snapshot_evict_points);
+        if (snapshot_path.empty() || snapshot_evict_turns <= 0 || slot.n_grow < snapshot_evict_turns ||
+            snapshot_evict_points == 0) {
+            return;
+        }
+        const server_tokens & toks = slot.prompt.tokens;
+
+        // three states matter, one per way the next prompt can be rendered:
+        //   bit 0: end of generation   - thinking preserved -> the follow-up is a pure append
+        //   bit 1: newest checkpoint   - thinking dropped   -> diverges at the last turn boundary
+        //   bit 2: 2nd newest          - only last thinking -> diverges one turn boundary earlier
+        // a token window is meaningless here: what counts is which boundary, not how far back it is.
+        std::vector<const common_prompt_checkpoint *> cps;
+        for (const auto & ck : slot.prompt.checkpoints) {
+            if (ck.n_tokens >= snapshot_min_prefix && (size_t) ck.n_tokens < toks.size()) {
+                cps.push_back(&ck);
+            }
+        }
+        std::sort(cps.begin(), cps.end(), [](const auto * a, const auto * b) { return a->n_tokens > b->n_tokens; });
+
+        // [SNAPSHOT] narrow the mask to what this session actually used. a client renders the
+        // history the same way every turn, so a state no turn ever resumed from will not be needed
+        // after eviction either - and each one costs ~41 KB per token on the SSD. only ever narrows,
+        // never widens: bits outside snapshot-evict-points stay off. with no informative turn yet
+        // (a single-turn slot, or one that only ever hit disk snapshots) nothing is narrowed and all
+        // configured points are written, which is the conservative case.
+        int32_t points = snapshot_evict_points;
+        if (snapshot_evict_learn) {
+            const int32_t seen = (slot.evict_hits[0] > 0 ? 1 : 0)
+                               | (slot.evict_hits[1] > 0 ? 2 : 0)
+                               | (slot.evict_hits[2] > 0 ? 4 : 0);
+            if (seen != 0) {
+                points &= seen;
+                SLT_INF(slot, "[snapshot] learned access pattern [live %d, newest %d, 2nd %d]: points 0x%x -> 0x%x\n",
+                        slot.evict_hits[0], slot.evict_hits[1], slot.evict_hits[2],
+                        snapshot_evict_points, points);
+            }
+        }
+
+        // descending, because every roll-back truncates. the live state (no roll-back) comes first.
+        struct step { int32_t n; const common_prompt_checkpoint * ck; const char * why; };
+        std::vector<step> steps;
+        if (points & 1) {
+            const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+            const int32_t   n_full  = std::min<int32_t>(pos_max + 1, (int32_t) toks.size());
+            if (n_full >= snapshot_min_prefix) {
+                steps.push_back({n_full, nullptr, "end of generation"});
+            }
+        }
+        if ((points & 2) && cps.size() >= 1) {
+            steps.push_back({(int32_t) cps[0]->n_tokens, cps[0], "newest checkpoint"});
+        }
+        if ((points & 4) && cps.size() >= 2) {
+            steps.push_back({(int32_t) cps[1]->n_tokens, cps[1], "2nd newest checkpoint"});
+        }
+        if (steps.empty()) {
+            return;
+        }
+
+        const int64_t t0 = ggml_time_us();
+        SLT_INF(slot, "[snapshot] slot leaves after %d growing turns: keeping %zu of %d states (points 0x%x, %zu checkpoints)\n",
+                slot.n_grow, steps.size(), 3, points, cps.size());
+
+        int n_saved = 0;
+        for (const auto & st : steps) {
+            if (st.ck) {
+                st.ck->load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                if (ctx_dft && !st.ck->data_dft.empty()) {
+                    st.ck->load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                }
+                if (slot.spec && !st.ck->data_spec.empty()) {
+                    common_speculative_set_state(slot.spec, slot.id, st.ck->data_spec);
+                }
+                slot.mem.seq_rm(slot.id, st.n, -1);
+                if (llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id) != st.n - 1) {
+                    SLT_WRN(slot, "[snapshot] roll-back to %d failed, stopping\n", st.n);
+                    break;
+                }
+            }
+            SLT_DBG(slot, "[snapshot] keeping %s at %d\n", st.why, st.n);
+            if (snapshot_save(slot, toks, st.n)) {
+                n_saved++;
+            }
+        }
+        SLT_INF(slot, "[snapshot] kept %d states in %.0f ms\n", n_saved, (ggml_time_us() - t0) / 1000.0);
+    }
+
+    // [KV_SHARE] once a prompt is fully in the slot, hand the cells of any prefix it shares with another
+    // slot over to that slot's copy: identical tokens at identical positions produce identical KV, so one
+    // physical copy serves both. done AFTER the prefill (operator's insight), which makes it independent of
+    // how the prompt got there - prefilled, restored from a snapshot, or a mix - and keeps the recurrent
+    // state out of it entirely, since each slot then already holds its own correct one.
+    //
+    // order matters: drop our own cells for [0, n) first, then borrow. seq_rm(seq, 0, n) leaves the
+    // recurrent state alone because its single cell sits at the sequence end, i.e. behind n. seq_cp does
+    // clobber it (it ignores p0/p1 and just re-points the tail), so we save and restore it around the
+    // call - with PARTIAL_ONLY, which the hybrid memory routes to the recurrent part only.
+    void kv_share_merge(server_slot & slot) {
+        if (kv_share_min <= 0 || !params_base.kv_unified || slot.prompt.tokens.size() == 0) {
+            return;
+        }
+
+        server_slot * from = nullptr;
+        size_t n_share = 0;
+        for (auto & other : slots) {
+            if (other.id == slot.id || other.prompt.tokens.size() == 0) {
+                continue;
+            }
+            const size_t lcp = other.prompt.tokens.get_common_prefix(slot.prompt.tokens);
+            if (lcp > n_share) {
+                n_share = lcp;
+                from    = &other;
+            }
+        }
+        if (from == nullptr || n_share < (size_t) kv_share_min) {
+            return;
+        }
+        // never hand over our whole sequence: we must keep at least the last token, and a prefix that
+        // already covers everything means the slot picker should have reused that slot instead
+        n_share = std::min(n_share, slot.prompt.tokens.size() - 1);
+        if (n_share < (size_t) kv_share_min) {
+            return;
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        std::vector<uint8_t> rs;
+        {
+            const size_t need = llama_state_seq_get_size_ext(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            rs.resize(need);
+            const size_t got = llama_state_seq_get_data_ext(ctx_tgt, rs.data(), rs.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            if (got == 0) {
+                SLT_WRN(slot, "%s", "[kv-share] cannot save the recurrent state, skipping merge\n");
+                return;
+            }
+            rs.resize(got);
+        }
+
+        slot.mem.seq_rm(slot.id, 0, (llama_pos) n_share);
+        slot.mem.seq_cp(from->id, slot.id, 0, (llama_pos) n_share);
+
+        if (llama_state_seq_set_data_ext(ctx_tgt, rs.data(), rs.size(), slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == 0) {
+            SLT_ERR(slot, "%s", "[kv-share] failed to restore the recurrent state after merge\n");
+            slot.prompt_clear();
+            return;
+        }
+
+        const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+        if (pos_max != (llama_pos) slot.prompt.tokens.size() - 1) {
+            SLT_WRN(slot, "[kv-share] merge left the sequence inconsistent (pos_max = %d, expected %zu), dropping slot\n",
+                    pos_max, slot.prompt.tokens.size() - 1);
+            slot.prompt_clear();
+            return;
+        }
+
+        slot.stats.tel_merged = (int32_t) n_share;
+        SLT_INF(slot, "[kv-share] merged %zu of %zu cells into slot %d in %.0f ms (%.2f GB of KV freed)\n",
+                n_share, slot.prompt.tokens.size(), from->id, (ggml_time_us() - t0) / 1000.0,
+                n_share * 42.6 / 1024 / 1024);
+    }
+
+    // the longest disk snapshot whose tokens are a prefix of this prompt:    // the longest disk snapshot whose tokens are a prefix of this prompt: {length, file name}, {0, ""} if
+    // none. one pass over the prompt, probing every known snapshot length (streaming FNV-1a).
+    std::pair<int32_t, std::string> snapshot_lookup(const server_tokens & tokens) const {
+        std::pair<int32_t, std::string> best = {0, ""};
+        if (snapshot_path.empty() || snapshot_lengths.empty() || tokens.size() < 2) {
+            return best;
+        }
+
+        const llama_tokens toks = snapshot_key_tokens(tokens);
+
+        // a snapshot must leave at least one token to decode
+        const size_t lim = toks.size() - 1;
+
+        uint64_t h = 1469598103934665603ull;
+        size_t   i = 0;
+        for (int32_t n : snapshot_lengths) {
+            if ((size_t) n > lim) {
+                break;
+            }
+            for (; i < (size_t) n; ++i) {
+                h ^= (uint64_t)(uint32_t) toks[i];
+                h *= 1099511628211ull;
+            }
+            const std::string cand = snapshot_name(h, n);
+            if (snapshot_files.count(cand)) {
+                best = {n, cand};
+            }
+        }
+        return best;
+    }
+
+    // restores the snapshot `found` (from snapshot_lookup) into the slot; returns its length, 0 on failure
+    int snapshot_try_load(server_slot & slot, const std::pair<int32_t, std::string> & found) {
+        const int32_t     n_sel = found.first;
+        const std::string name  = found.second;
+        if (n_sel == 0) {
+            return 0;
+        }
+
+        const llama_tokens toks = snapshot_key_tokens(slot.task->tokens);
+        const std::string  path = snapshot_path + "/" + name;
+
+        std::ifstream f(path, std::ios::binary);
+        if (!f) {
+            SLT_WRN(slot, "[snapshot] file vanished, dropping from index: %s\n", path.c_str());
+            snapshot_forget(name, false);
+            return 0;
+        }
+
+        const int64_t t0 = ggml_time_us();
+
+        char magic[4]; f.read(magic, 4);
+        uint32_t version = 0, n_ubatch = 0, n_ctx_seq = 0, n_tokens = 0;
+        uint64_t model_size = 0, n_params = 0;
+        harness_info hinfo;
+        bool hdr_ok = f && memcmp(magic, "LSNP", 4) == 0 && rd(f, version) && (version == 1 || version == 2);
+        if (hdr_ok && version >= 2) {
+            // read the fields we know, seek past the ones a newer writer added. version 1 has no
+            // block at all and simply reports type 0 = unknown, so older files stay loadable.
+            uint32_t n_info = 0;
+            hdr_ok = rd(f, n_info);
+            if (hdr_ok) {
+                uint32_t got = 0;
+                if (n_info >= sizeof(hinfo.type) && rd(f, hinfo.type)) { got += sizeof(hinfo.type); }
+                if (n_info > got) { f.seekg(n_info - got, std::ios::cur); }
+            }
+        }
+        if (!hdr_ok ||
+            !rd(f, model_size) || !rd(f, n_params) || !rd(f, n_ubatch) || !rd(f, n_ctx_seq) || !rd(f, n_tokens)) {
+            SLT_WRN(slot, "[snapshot] bad header: %s\n", path.c_str());
+            return 0;
+        }
+        if (model_size != llama_model_size(model_tgt) || n_params != llama_model_n_params(model_tgt) ||
+            n_ubatch != llama_n_ubatch(ctx_tgt) || n_ctx_seq != llama_n_ctx_seq(ctx_tgt) || (int32_t) n_tokens != n_sel) {
+            SLT_WRN(slot, "[snapshot] configuration mismatch, ignoring %s\n", path.c_str());
+            snapshot_forget(name, false);
+            return 0;
+        }
+
+        llama_tokens saved(n_tokens);
+        f.read((char *) saved.data(), (size_t) n_tokens * sizeof(llama_token));
+        if (!f || !std::equal(saved.begin(), saved.end(), toks.begin())) {
+            SLT_WRN(slot, "[snapshot] token mismatch (hash collision?), ignoring %s\n", path.c_str());
+            return 0;
+        }
+
+        common_prompt_checkpoint ck;
+        if (!rd_blob(f, ck.data_tgt) || !rd_blob(f, ck.data_dft) || !rd_blob(f, ck.data_spec)) {
+            SLT_WRN(slot, "[snapshot] truncated: %s\n", path.c_str());
+            return 0;
+        }
+        ck.update_pos(n_tokens, 0, n_tokens - 1);
+
+        // the slot must be empty: drop whatever it held, then restore the full state
+        slot.mem.seq_rm(slot.id, -1, -1);
+        ck.load_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        if (ctx_dft && !ck.data_dft.empty()) {
+            ck.load_dft(ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        }
+        if (slot.spec && !ck.data_spec.empty()) {
+            common_speculative_set_state(slot.spec, slot.id, ck.data_spec);
+        }
+
+        // the slot now holds the first n_sel tokens of the task, images included
+        slot.prompt.tokens = slot.task->tokens.clone();
+        slot.prompt.tokens.keep_first(n_sel);
+        slot.prompt.checkpoints.clear();
+
+        // remember the use, on disk too, so LRU order survives restarts
+        snapshot_files[name].last_used = snapshot_now();
+        {
+            std::error_code ec;
+            std::filesystem::last_write_time(path, std::filesystem::file_time_type::clock::now(), ec);
+        }
+
+        SLT_INF(slot, "[snapshot] restored %u tokens, %.1f MB in %.0f ms, harness type 0x%x <- %s\n",
+                n_tokens, ck.size() / 1e6, (ggml_time_us() - t0) / 1000.0, hinfo.type, path.c_str());
+        return (int) n_tokens;
+    }
+
+    // decide whether this prompt should write a snapshot, and where; inserts the prompt into the
+    // prompt tree. called for every prompt; n_past = where its prefill starts (0, a restored snapshot,
+    // or a continuation's checkpoint) - a fork behind it is computed anyway, so the save is nearly free;
+    // a fork before it cannot be saved from this prompt (operator's rule: only when the last matching
+    // checkpoint lies before the divergence).
+    // the position is the exact point up to which min_hits-1 indexed prompts agree with this one:
+    // the (min_hits-1)-th largest common prefix length. no block grid, no hashing of blocks.
+    int32_t snapshot_plan(server_slot & slot, int32_t n_past) {
+        if (snapshot_path.empty()) {
+            return 0;
+        }
+
+        const llama_tokens toks = snapshot_key_tokens(slot.task->tokens);
+        const size_t len = toks.size();
+        const size_t lim = std::min(len - 1, (size_t) snapshot_max_depth);
+
+        // [TELEMETRY] before any rule is applied: how long a prefix does this prompt share with the
+        // index? two-fold = with the single best entry, three-fold = with the best two (the
+        // (min_hits-1)-th largest common prefix, which is what the divergence rule needs). scanned
+        // over ALL entries, not just the hash bucket, so a match shorter than snapshot-min-prefix is
+        // visible too. no stub/branch filtering here - this is what we SAW, not what we accepted.
+        {
+            int32_t l1 = 0, l2 = 0;
+            for (const auto & seq : snapshot_seqs) {
+                const size_t m = std::min(seq.toks.size(), len);
+                size_t l = 0;
+                while (l < m && seq.toks[l] == toks[l]) {
+                    ++l;
+                }
+                if ((int32_t) l > l1) { l2 = l1; l1 = (int32_t) l; }
+                else if ((int32_t) l > l2) { l2 = (int32_t) l; }
+            }
+            auto & st = slot.stats;
+            st.tel_idx_lcp2 = l1;
+            st.tel_idx_lcp3 = l2;
+            st.tel_idx_size = (int32_t) snapshot_seqs.size();
+        }
+
+        int32_t target = 0;
+
+        if (snapshot_at > 0) {
+            // test override: fixed position, no index
+            target = (size_t) snapshot_at <= lim ? snapshot_at : 0;
+        } else {
+            if (lim < (size_t) snapshot_min_prefix || snapshot_index_size == 0) {
+                return 0;
+            }
+            const uint64_t bucket = snapshot_hash(toks, snapshot_min_prefix);
+
+            // the index holds the LEAVES of the prompt tree. against every leaf in the bucket, find the fork
+            // with this prompt and how far each side continues past it:
+            //  - a side that stops within min_branch tokens is not a branch: the stored one is then a prefix
+            //    or the stub of a superseded turn (its generation suffix) -> this prompt replaces it; if this
+            //    prompt is the short side it adds nothing -> not inserted
+            //  - otherwise the leaf is a witness: a genuine branch off this prompt at depth l, starting with
+            //    token seq[l]
+            // a side truncated at max_depth continues beyond what we can see and counts as long.
+            struct witness { int32_t l; llama_token tok; };
+            std::vector<witness> wit;
+            std::vector<size_t>  drop;
+            bool insert = true;
+
+            const size_t n_s = lim;
+            for (size_t i = 0; i < snapshot_seqs.size(); ++i) {
+                const auto & seq = snapshot_seqs[i];
+                if (seq.bucket != bucket) {
+                    continue;
+                }
+                const size_t n_t = seq.toks.size();
+                const size_t m   = std::min(n_t, n_s);
+                size_t l = 0;
+                while (l < m && seq.toks[l] == toks[l]) {
+                    ++l;
+                }
+                const bool t_short = n_t < (size_t) snapshot_max_depth && n_t - l < (size_t) snapshot_min_branch;
+                const bool s_short = n_s < (size_t) snapshot_max_depth && n_s - l < (size_t) snapshot_min_branch;
+                if (t_short) {
+                    if (!s_short) {
+                        drop.push_back(i); // prefix or stub of this prompt: superseded
+                    } else {
+                        insert = false;    // identical, or two stubs: keep what we have
+                    }
+                    continue;
+                }
+                if (s_short) {
+                    insert = false;        // this prompt is a prefix or stub of a stored leaf
+                    continue;
+                }
+                wit.push_back({(int32_t) l, seq.toks[l]});
+            }
+            for (auto it = drop.rbegin(); it != drop.rend(); ++it) {
+                snapshot_seqs.erase(snapshot_seqs.begin() + *it);
+            }
+            if (insert) {
+                snapshot_seqs.push_back({bucket, llama_tokens(toks.begin(), toks.begin() + lim)});
+                while (snapshot_seqs.size() > (size_t) snapshot_index_size) {
+                    snapshot_seqs.pop_front();
+                }
+            }
+
+            // divergence = a node with min_hits distinct children: the distinct next tokens of the witnesses
+            // forking exactly there, plus this prompt's own. one session cannot produce it - rewriting its
+            // history makes forks with two arms, never three. the deepest such node wins.
+            std::map<int32_t, std::set<llama_token>> kids;
+            for (const auto & w : wit) {
+                kids[w.l].insert(w.tok);
+            }
+            for (auto it = kids.rbegin(); it != kids.rend(); ++it) {
+                if (it->second.size() + 1 >= (size_t) snapshot_min_hits) {
+                    target = it->first;
+                    SLT_DBG(slot, "[snapshot] fork at %d has %zu branches (%zu witnesses, %zu superseded, index %zu)\n",
+                            target, it->second.size() + 1, wit.size(), drop.size(), snapshot_seqs.size());
+                    break;
+                }
+            }
+            if (target < snapshot_min_prefix) {
+                if (!wit.empty()) {
+                    SLT_DBG(slot, "[snapshot] %zu witnesses, no fork with %d branches (%zu superseded, index %zu)\n",
+                            wit.size(), snapshot_min_hits, drop.size(), snapshot_seqs.size());
+                }
+                return 0;
+            }
+        }
+
+        target = snapshot_align_media(slot.task->tokens, target);
+
+        // [SNAPSHOT] keep-out zone BEHIND an existing snapshot: two prompts differing only in their
+        // question word would otherwise each get their own multi-GB file. in front is always allowed -
+        // a shorter prefix serves more prompts.
+        if (slot.snap_cover > 0 && target > slot.snap_cover && target - slot.snap_cover < snapshot_min_gap) {
+            SLT_DBG(slot, "[snapshot] fork at %d is only %d tokens behind the snapshot at %d, skipping (min-gap %d)\n",
+                    target, target - slot.snap_cover, slot.snap_cover, snapshot_min_gap);
+            return 0;
+        }
+
+        if (target <= n_past) {
+            return 0; // behind the start of this prefill: covered already, or not ours to compute
+        }
+        if (snapshot_files.count(snapshot_name(snapshot_hash(toks, target), target))) {
+            return 0; // on disk already (then n_loaded would normally be >= target; keep it safe)
+        }
+
+        SLT_INF(slot, "[snapshot] planning snapshot at %d of %zu tokens (prefill starts at %d)\n", target, len, n_past);
+        return target;
+    }
+
+    // [SLOT_EVICT] stage B: make sure the unified KV pool has room for this task.
+    //
+    // slot availability and cell availability are two different things: with unified KV all
+    // sequences draw from one pool of n_ctx cells, so a free slot is worthless when the pool
+    // is full, and a small request needs no eviction at all when enough cells are free.
+    //
+    // returns false when the task should wait (stay queued) instead of destroying context.
+    // deviation from the spec: `need` is clamped to n_ctx instead of returning an error for
+    // oversized prompts - that case is already rejected upstream with exceed_context_size_error,
+    // so this function has exactly one failure mode and maps cleanly onto "defer".
+    bool ensure_kv_cells(const server_slot * ret, const server_task & task) {
+        if (!evict.enabled) {
+            return true; // upstream behaviour untouched
+        }
+
+        const int64_t t_now       = ggml_time_us();
+        // [SLOT_EVICT] with separate streams there is nothing to compete for: each sequence owns
+        // n_ctx / n_seq_max cells that no other slot can take, and a prompt too large for that is
+        // rejected earlier against n_ctx_slot(). evicting a neighbour would free nothing usable.
+        if (!params_base.kv_unified) {
+            return true;
+        }
+
+        const size_t  n_ctx_total = (size_t) n_ctx;
+
+        bool any_processing = false;
+        for (const auto & s : slots) {
+            any_processing = any_processing || s.is_processing();
+        }
+
+        // cells held by OTHER slots. `ret`'s own cells must not be counted: whatever it holds
+        // is either reused as the common prefix of this very task or dropped at launch
+        // (mem.seq_rm past the prefix), so it is not competing demand. counting them would
+        // double-count the prefix on an LCP hit - `need` already includes it - and could
+        // defer a task forever when no other slot has anything to evict.
+        size_t used_others = 0;
+        for (const auto & s : slots) {
+            if (&s == ret) {
+                continue;
+            }
+
+            used_others += s.prompt.tokens.size();
+        }
+
+        const size_t reserve = std::max<size_t>(evict.reserve_min,
+                task.params.n_predict > 0 ? (size_t) task.params.n_predict : 0);
+
+        const size_t need       = std::min(task.tokens.size() + reserve, n_ctx_total);
+        const size_t free_cells = n_ctx_total > used_others ? n_ctx_total - used_others : 0;
+
+        if (free_cells >= need) {
+            return true;
+        }
+
+        const size_t deficit = need - free_cells;
+
+        SRV_DBG("[evict] need = %zu, used by others = %zu of %zu, free = %zu, deficit = %zu\n",
+                need, used_others, n_ctx_total, free_cells, deficit);
+
+        struct evict_cand {
+            server_slot * slot;
+            size_t        n;
+            double        value;
+        };
+
+        std::vector<evict_cand> cands;
+
+
+        for (auto & s : slots) {
+            if (s.is_processing() || &s == ret || s.prompt.tokens.empty()) {
+                continue;
+            }
+
+
+            cands.push_back({ &s, s.prompt.tokens.size(), slot_value(s, t_now, evict) });
+        }
+
+        // choose the eviction set: cheapest total value that covers the deficit.
+        // exact subset search while it is cheap; greedy by value above that.
+        const size_t m = cands.size();
+
+        std::vector<size_t> chosen;
+
+        // deviation from the spec: only wait when a running slot can actually free cells.
+        // otherwise there is nothing to wait for and deferring would hang the task forever -
+        // let it proceed and be handled by the normal (error) path instead.
+        if (m == 0) {
+            SRV_DBG("[evict] no candidates, %s\n", any_processing ? "deferring" : "proceeding anyway");
+            return !any_processing;
+        }
+
+        if (m <= 16) {
+            uint32_t best_mask = 0;
+            double   best_val  = std::numeric_limits<double>::max();
+
+            for (uint32_t mask = 1; mask < (1u << m); ++mask) {
+                size_t sum_n = 0;
+                double sum_v = 0.0;
+
+                for (size_t i = 0; i < m; ++i) {
+                    if (mask & (1u << i)) {
+                        sum_n += cands[i].n;
+                        sum_v += cands[i].value;
+                    }
+                }
+
+                if (sum_n >= deficit && sum_v < best_val) {
+                    best_val  = sum_v;
+                    best_mask = mask;
+                }
+            }
+
+            if (best_mask == 0) {
+                SRV_DBG("[evict] even evicting everything is not enough, %s\n", any_processing ? "deferring" : "proceeding anyway");
+                return !any_processing;
+            }
+
+            for (size_t i = 0; i < m; ++i) {
+                if (best_mask & (1u << i)) {
+                    chosen.push_back(i);
+                }
+            }
+        } else {
+            // greedy: cheapest value per cell first. the length cancels out in density, so
+            // this ranks by "how little we lose per freed cell".
+            std::vector<size_t> order(m);
+            for (size_t i = 0; i < m; ++i) {
+                order[i] = i;
+            }
+
+            std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+                return cands[a].value < cands[b].value;
+            });
+
+            size_t sum_n = 0;
+            for (size_t i : order) {
+                chosen.push_back(i);
+                sum_n += cands[i].n;
+
+                if (sum_n >= deficit) {
+                    break;
+                }
+            }
+
+            if (sum_n < deficit) {
+                SRV_DBG("[evict] even evicting everything is not enough, %s\n", any_processing ? "deferring" : "proceeding anyway");
+                return !any_processing;
+            }
+        }
+
+        for (size_t i : chosen) {
+            auto & c = *cands[i].slot;
+
+            SLT_INF(c, "[evict] evicting slot: n = %zu, grow = %d, age = %.0fs, value = %.0f\n",
+                    cands[i].n, c.n_grow, slot_age_s(c, t_now), cands[i].value);
+
+            snapshot_dump_slot(c);
+            c.prompt_clear(); // drops attention cells, recurrent state AND checkpoints
+        }
+
+        return true;
+    }
